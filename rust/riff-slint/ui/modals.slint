import { Slider, ScrollView, AboutSlint, TextEdit, LineEdit } from "std-widgets.slint";
import { Theme, LyricLineData, SyncLineData, PlaylistData } from "theme.slint";
import { IconBtn, PillBtn, ToggleSwitch, ScrubberBar, WinBtn } from "components.slint";

export component Titlebar inherits Rectangle {
    in property <bool> revealed: false;
    in property <bool> lyrics-open: true;
    in property <bool> is-maximized: false;
    in property <bool> mini-mode: false;
    out property <bool> any-hover: drag-ta.has-hover || btn-lyrics.hovered || btn-mini.hovered || btn-min.hovered || btn-max.hovered || btn-close.hovered;

    callback toggle-lyrics();
    callback mini-player();
    callback go-home();
    callback minimize();
    callback maximize();
    callback close();

    height: 40px;
    y: revealed ? 0px : -42px;
    opacity: revealed ? 1.0 : 0.0;
    visible: revealed || self.opacity > 0.01;
    background: #18181be8;
    backdrop-blur: 16px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000066;

    animate y { duration: 220ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    animate opacity { duration: 180ms; easing: ease; }

    // Bottom hairline border
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: #ffffff14;
    }

    // Drag region across the bar
    WindowMoveArea {
        width: 100%;
        height: 100%;

        drag-ta := TouchArea {
            double-clicked => { root.maximize(); }
        }
    }

    // Centered Riff logo
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: logo-ta.has-hover ? #ffffff12 : transparent;
        animate background { duration: 140ms; easing: ease-out; }

        Image {
            source: @image-url("assets/riff.svg");
            width: 20px;
            height: 20px;
            colorize: Theme.primary;
            x: 6px;
            y: 6px;
        }

        logo-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.go-home(); }
        }
    }

    // Right window controls (persis src/renderer/index.html)
    HorizontalLayout {
        x: parent.width - self.width - 10px;
        y: 0px;
        height: 40px;
        spacing: 4px;
        alignment: end;

        // Lyrics toggle
        btn-lyrics := WinBtn {
            width: 34px;
            icon: @image-url("icons/win_lyrics.svg");
            active: root.lyrics-open;
            active-icon-color: Theme.primary;
            revealed: root.revealed;
            reveal-delay: 0ms;
            clicked => { root.toggle-lyrics(); }
        }

        // Compact mini player / toggle lyrics
        btn-mini := WinBtn {
            width: 34px;
            icon: @image-url("icons/win_mini_player.svg");
            revealed: root.revealed;
            reveal-delay: 30ms;
            clicked => { root.mini-player(); }
        }

        // Minimize
        btn-min := WinBtn {
            width: 36px;
            icon: @image-url("icons/win_minimize.svg");
            revealed: root.revealed;
            reveal-delay: 60ms;
            clicked => { root.minimize(); }
        }

        // Maximize / Restore
        btn-max := WinBtn {
            width: 36px;
            icon: @image-url("icons/win_maximize.svg");
            icon-size: 13px;
            revealed: root.revealed;
            reveal-delay: 90ms;
            clicked => { root.maximize(); }
        }

        // Close
        btn-close := WinBtn {
            width: 36px;
            icon: @image-url("icons/ms_close.svg");
            icon-size: 15px;
            hover-bg: #b3261e;
            hover-icon-color: #ffffff;
            revealed: root.revealed;
            reveal-delay: 120ms;
            clicked => { root.close(); }
        }
    }
}

export component PresetsDrawer inherits Rectangle {
    in-out property <string> eq-preset-name: "Default";
    in-out property <float> eq-bass: 0.0;
    in-out property <float> eq-mid: 0.0;
    in-out property <float> eq-treble: 0.0;
    in property <bool> ambient-active: false;
    in property <bool> open: false;
    callback apply-preset(string);
    callback set-eq(float, float, float);
    callback close();

    // Continuous animation phases matching @keyframes presetsMainFloat (4.2s) & presetsNoteTg (3.6s)
    property <float> t-sec: open ? (animation-tick() / 1s) : 0.0;
    property <float> float-y: Math.sin(t-sec * 1.496rad) * 5.0;
    property <float> p1: Math.mod(t-sec / 3.6, 1.0);
    property <float> p2: Math.mod(t-sec / 3.6 + 0.25, 1.0);
    property <float> p3: Math.mod(t-sec / 3.6 + 0.50, 1.0);
    property <float> p4: Math.mod(t-sec / 3.6 + 0.75, 1.0);

    width: 220px;
    background: #18191cd9;
    backdrop-blur: 24px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #ffffff14;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000080;
    clip: true;

    // Swallow clicks so they don't pass through to MainContent behind the overlay
    TouchArea {}

    // Animated background decor (.presets-bg-decor)
    Rectangle {
        width: 120px;
        height: 120px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px;

        // Floating music notes (n1..n4)
        Image {
            source: @image-url("icons/music_note.svg");
            width: 18px;
            height: 18px;
            colorize: Theme.text-primary;
            x: 34px - 14px * p1;
            y: 36px + 8px - 66px * p1;
            opacity: p1 < 0.25 ? (p1 / 0.25) * 0.14 : (p1 < 0.75 ? 0.14 - ((p1 - 0.25) / 0.5) * 0.05 : (1.0 - p1) / 0.25 * 0.09);
        }
        Image {
            source: @image-url("icons/music_note.svg");
            width: 18px;
            height: 18px;
            colorize: Theme.text-primary;
            x: 62px + 16px * p2;
            y: 32px + 8px - 66px * p2;
            opacity: p2 < 0.25 ? (p2 / 0.25) * 0.14 : (p2 < 0.75 ? 0.14 - ((p2 - 0.25) / 0.5) * 0.05 : (1.0 - p2) / 0.25 * 0.09);
        }
        Image {
            source: @image-url("icons/music_note.svg");
            width: 18px;
            height: 18px;
            colorize: Theme.text-primary;
            x: 46px - 8px * p3;
            y: 28px + 8px - 66px * p3;
            opacity: p3 < 0.25 ? (p3 / 0.25) * 0.14 : (p3 < 0.75 ? 0.14 - ((p3 - 0.25) / 0.5) * 0.05 : (1.0 - p3) / 0.25 * 0.09);
        }
        Image {
            source: @image-url("icons/music_note.svg");
            width: 18px;
            height: 18px;
            colorize: Theme.text-primary;
            x: 56px + 12px * p4;
            y: 38px + 8px - 66px * p4;
            opacity: p4 < 0.25 ? (p4 / 0.25) * 0.14 : (p4 < 0.75 ? 0.14 - ((p4 - 0.25) / 0.5) * 0.05 : (1.0 - p4) / 0.25 * 0.09);
        }

        // Main floating equalizer icon
        Image {
            source: @image-url("icons/ms_discover_tune.svg");
            width: 88px;
            height: 88px;
            colorize: Theme.text-primary;
            opacity: 0.08;
            x: 16px;
            y: 16px + float-y * 1px;
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;

        // Header (persis web_presets.png)
        HorizontalLayout {
            height: 40px;
            spacing: 4px;
            Text {
                text: "Presets";
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconBtn {
                width: 36px;
                height: 36px;
                icon: @image-url("icons/ms_add.svg");
                icon-size: 18px;
                clicked => {
                    eq-preset-name = "Default";
                    root.apply-preset("p_default");
                }
            }
            IconBtn {
                width: 36px;
                height: 36px;
                icon: @image-url("icons/ms_close.svg");
                icon-size: 18px;
                clicked => { root.close(); }
            }
        }

        // Preset chips (persis web_presets.png & defaultPresets in state.js)
        VerticalLayout {
            spacing: 6px;
            alignment: start;

            for p in [
                { id: "p_default", label: "Default" },
                { id: "p_speedup", label: "Speed up (orig pitch)" },
                { id: "p_speedup_pitch", label: "Speed up" },
                { id: "p_slowed", label: "Slowed + reverb" },
                { id: "p_nightcore", label: "Nightcore" },
                { id: "p_distortion", label: "Distortion" },
            ]: HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 32px;
                    border-radius: 10px;
                    background: eq-preset-name == p.label ? Theme.primary : (pta.has-hover ? #36343b : #2b2930);
                    animate background { duration: 160ms; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: p.label;
                            color: eq-preset-name == p.label ? Theme.on-primary : #ffffff;
                            font-size: 12.5px;
                            font-weight: eq-preset-name == p.label ? 600 : 500;
                            vertical-alignment: center;
                        }
                    }

                    pta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            eq-preset-name = p.label;
                            root.apply-preset(p.id);
                        }
                    }
                }
            }
        }
    }
}

export component RightPanel inherits Rectangle {
    in property <string> current-id: "";
    in property <string> current-title: "No track playing";
    in property <string> current-artist: "Select a track to listen";
    in property <bool> current-is-favorite: false;
    in property <image> current-cover;
    in property <bool> current-has-cover: false;
    in property <image> current-cover-blur;
    in property <bool> current-has-blur: false;
    in property <color> accent-color: Theme.primary;
    in property <bool> has-accent: false;
    in property <bool> ambient-active: false;
    in property <bool> banner-enabled: true;
    in property <bool> gradient-enabled: true;
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in-out property <string> lyrics-mode: "Word";
    in-out property <string> lyrics-source: "auto";
    in property <string> lyrics-source-label: "Auto";
    in property <bool> lyrics-is-synced: false;
    in property <bool> lyrics-warnings: true;
    in property <bool> lyrics-autoscroll: true;
    in-out property <string> lyrics-word-style: "gradient";
    in property <float> lyrics-speed: 1.0;
    in property <string> lyrics-focus-pos: "center";
    in property <bool> lyrics-fullscreen-only: false;
    in-out property <float> lyrics-offset-ms: 0.0;
    callback seek-to(float);
    callback edit-lyrics();
    callback sync-lyrics();
    callback open-fullscreen();
    callback toggle-favorite();
    callback change-lyrics-source(string);
    callback set-lyrics-offset(float);
    callback clear-custom-lyrics();
    callback save-setting(string, string);
    callback open-artist(string);
    callback close();

    property <bool> source-picker-open: false;

    width: 350px;
    background: (ambient-active && Theme.ambient-blur-enabled)
        ? Theme.right-panel-bg.with-alpha(Theme.panel-opacity)
        : Theme.right-panel-bg;
    backdrop-blur: (ambient-active && Theme.ambient-blur-enabled) ? 28px : 0px;
    border-radius: 10px;
    clip: true;
    animate background { duration: Theme.reduced-motion ? 0ms : 400ms; easing: ease; }

    // Blurred cover banner (.right-panel-banner equivalent, seamless full-height fade)
    if banner-enabled && current-has-blur: Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        Image {
            source: current-cover-blur;
            width: parent.width * 1.15;
            height: parent.height * 1.15;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: cover;
            opacity: 0.42;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, transparent 0%, #16161888 45%, #161618dd 100%);
        }
    }

    // Top ambient accent gradient (#right-panel::before equivalent)
    if gradient-enabled: Rectangle {
        width: 100%;
        height: 100%;
        background: has-accent
            ? @linear-gradient(180deg, accent-color.with-alpha(0.28) 0%, accent-color.with-alpha(0.10) 45%, #ffffff03 75%, transparent 100%)
            : @linear-gradient(180deg, #ffffff1e 0%, #ffffff0a 45%, #ffffff03 75%, transparent 100%);
        animate background { duration: Theme.reduced-motion ? 0ms : 400ms; easing: ease; }
    }

    panel-ta := TouchArea {}

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Header actions (Edit, Sync, Fullscreen, Line/Word, Close — persis src/renderer/index.html)
        HorizontalLayout {
            height: 32px;
            spacing: 6px;
            alignment: end;
            opacity: (current-id != "" || lyrics-lines.length > 0 || panel-ta.has-hover) ? 1.0 : 0.0;
            animate opacity { duration: 180ms; easing: ease-out; }

            // Edit lyrics
            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: edit-ta.has-hover ? #ffffff28 : #ffffff1a;
                animate background { duration: 140ms; easing: ease-out; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("icons/ms_edit.svg"); width: 14px; height: 14px; colorize: Theme.text-primary; }
                    }
                    Text { text: "Edit"; color: Theme.text-primary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                }
                edit-ta := TouchArea { mouse-cursor: pointer; clicked => { root.edit-lyrics(); } }
            }

            // Sync lyrics
            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: sync-ta.has-hover ? #ffffff28 : #ffffff1a;
                animate background { duration: 140ms; easing: ease-out; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("icons/clock.svg"); width: 14px; height: 14px; colorize: Theme.text-primary; }
                    }
                    Text { text: "Sync"; color: Theme.text-primary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                }
                sync-ta := TouchArea { mouse-cursor: pointer; clicked => { root.sync-lyrics(); } }
            }

            // Fullscreen karaoke
            IconBtn {
                width: 28px;
                height: 28px;
                base-bg: #ffffff1a;
                icon: @image-url("icons/fullscreen.svg");
                icon-size: 15px;
                icon-color: Theme.text-primary;
                clicked => { root.open-fullscreen(); }
            }

            // Line / Word mode toggle
            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: lyrics-mode == "Word" ? Theme.primary.with-alpha(0.28) : (mode-ta.has-hover ? #ffffff28 : #ffffff1a);
                animate background { duration: 140ms; easing: ease-out; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: lyrics-mode;
                        color: lyrics-mode == "Word" ? Theme.primary : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                mode-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        lyrics-mode = lyrics-mode == "Line" ? "Word" : "Line";
                        root.save-setting("slint_lyrics_mode", lyrics-mode);
                    }
                }
            }

            IconBtn {
                width: 28px;
                height: 28px;
                icon: @image-url("icons/ms_close.svg");
                icon-size: 16px;
                clicked => { root.close(); }
            }
        }

        // Sync & Source status pill + quick source switcher
        if current-id != "" && (lyrics-lines.length > 0 || lyrics-warnings): VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Rectangle {
                    height: 24px;
                    border-radius: 12px;
                    background: src-ta.has-hover ? #ffffff22 : #ffffff12;
                    animate background { duration: 140ms; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: lyrics-lines.length == 0 ? #f28b82 : (lyrics-is-synced ? #81c784 : #ffb74d);
                            }
                        }

                        Text {
                            text: lyrics-lines.length == 0
                                ? "No lyrics • " + lyrics-source-label
                                : (lyrics-is-synced ? "Synced • " + lyrics-source-label : "Unsynced • " + lyrics-source-label);
                            color: Theme.text-secondary;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    src-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { source-picker-open = !source-picker-open; }
                    }
                }

                if lyrics-lines.length > 0 && !lyrics-is-synced: Rectangle {
                    height: 24px;
                    border-radius: 12px;
                    background: tap-sync-ta.has-hover ? Theme.primary : Theme.primary.with-alpha(0.22);
                    animate background { duration: 140ms; easing: ease-out; }
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        Text {
                            text: "Tap to sync";
                            color: tap-sync-ta.has-hover ? Theme.on-primary : Theme.primary;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    tap-sync-ta := TouchArea { mouse-cursor: pointer; clicked => { root.sync-lyrics(); } }
                }
            }

            if source-picker-open: VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for src in [
                        { id: "auto", label: "Auto" },
                        { id: "lrclib", label: "LRCLIB" },
                        { id: "musixmatch", label: "Musixmatch" },
                        { id: "kugou", label: "Kugou" },
                        { id: "netease", label: "NetEase" },
                        { id: "genius", label: "Genius" },
                    ]: Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        background: lyrics-source == src.id ? Theme.primary : (sp-ta.has-hover ? #ffffff24 : #ffffff12);
                        animate background { duration: 120ms; easing: ease-out; }
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: src.label;
                                color: lyrics-source == src.id ? Theme.on-primary : Theme.text-secondary;
                                font-size: 10.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        sp-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                lyrics-source = src.id;
                                source-picker-open = false;
                                root.change-lyrics-source(src.id);
                            }
                        }
                    }
                }

                // Quick Sync Offset & Reset Custom controls
                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    Text {
                        text: "Sync: " + (lyrics-offset-ms >= 0 ? "+" : "") + Math.round(lyrics-offset-ms) + "ms";
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    PillBtn {
                        label: "-250ms";
                        btn-height: 22px;
                        h-pad: 7px;
                        radius: 8px;
                        clicked => {
                            lyrics-offset-ms = clamp(lyrics-offset-ms - 250.0, -5000.0, 5000.0);
                            root.set-lyrics-offset(lyrics-offset-ms);
                        }
                    }
                    PillBtn {
                        label: "0";
                        btn-height: 22px;
                        h-pad: 7px;
                        radius: 8px;
                        clicked => {
                            lyrics-offset-ms = 0.0;
                            root.set-lyrics-offset(0.0);
                        }
                    }
                    PillBtn {
                        label: "+250ms";
                        btn-height: 22px;
                        h-pad: 7px;
                        radius: 8px;
                        clicked => {
                            lyrics-offset-ms = clamp(lyrics-offset-ms + 250.0, -5000.0, 5000.0);
                            root.set-lyrics-offset(lyrics-offset-ms);
                        }
                    }
                    if lyrics-source-label == "Custom": PillBtn {
                        label: "Reset";
                        btn-height: 22px;
                        h-pad: 7px;
                        radius: 8px;
                        clicked => { root.clear-custom-lyrics(); }
                    }
                }
            }
        }

        // Empty / Artwork view (persis web_cdp.png)
        if lyrics-lines.length == 0 || lyrics-fullscreen-only: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 10px;

            Rectangle {
                height: min(300px, parent.width);
                border-radius: 12px;
                background: #111113;
                drop-shadow-blur: current-has-cover ? 28px : 0px;
                drop-shadow-offset-y: 10px;
                drop-shadow-color: current-has-cover ? accent-color.with-alpha(0.35) : transparent;

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 12px;
                    clip: true;

                    if current-has-cover: Image {
                        source: current-cover;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }

                    if !current-has-cover: Image {
                        source: @image-url("icons/play_circle.svg");
                        width: 36px;
                        height: 36px;
                        colorize: Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: current-title;
                        color: Theme.text-primary;
                        font-size: 30px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 26px;
                        Text {
                            width: 100%;
                            text: current-artist;
                            color: rp-art-ta1.has-hover && current-id != "" ? Theme.primary : Theme.text-secondary;
                            font-size: 19px;
                            font-weight: 500;
                            overflow: elide;
                        }
                        rp-art-ta1 := TouchArea {
                            enabled: current-id != "";
                            mouse-cursor: current-id != "" ? pointer : default;
                            clicked => { root.open-artist(current-artist); }
                        }
                    }
                }
                if current-id != "": VerticalLayout {
                    alignment: center;
                    IconBtn {
                        width: 34px;
                        height: 34px;
                        icon: current-is-favorite ? @image-url("icons/heart_fill.svg") : @image-url("icons/heart_outline.svg");
                        icon-size: 18px;
                        icon-color: current-is-favorite ? Theme.primary : Theme.text-secondary;
                        clicked => { root.toggle-favorite(); }
                    }
                }
            }
        }

        // Synced Lyrics view
        if lyrics-lines.length > 0 && !lyrics-fullscreen-only: VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                height: 48px;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 8px;
                    background: #111113;
                    clip: true;

                    if current-has-cover: Image {
                        source: current-cover;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                    if !current-has-cover: Image {
                        source: @image-url("icons/play_circle.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.text-muted;
                        x: 14px;
                        y: 14px;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: current-title; color: Theme.text-primary; font-size: 15px; font-weight: 700; overflow: elide; }
                    Rectangle {
                        height: 18px;
                        Text {
                            width: 100%;
                            text: current-artist;
                            color: rp-art-ta2.has-hover && current-id != "" ? Theme.primary : Theme.text-secondary;
                            font-size: 13px;
                            overflow: elide;
                        }
                        rp-art-ta2 := TouchArea {
                            enabled: current-id != "";
                            mouse-cursor: current-id != "" ? pointer : default;
                            clicked => { root.open-artist(current-artist); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        width: 32px;
                        height: 32px;
                        icon: current-is-favorite ? @image-url("icons/heart_fill.svg") : @image-url("icons/heart_outline.svg");
                        icon-size: 17px;
                        icon-color: current-is-favorite ? Theme.primary : Theme.text-secondary;
                        clicked => { root.toggle-favorite(); }
                    }
                }
            }

            rp-scroll := ScrollView {
                vertical-stretch: 1;
                property <length> base-target: max(0px, active-lyric-index * 52px);
                property <length> focus-offset: lyrics-focus-pos == "top"
                    ? self.visible-height * 0.28
                    : (lyrics-focus-pos == "bottom" ? -self.visible-height * 0.28 : 0px);
                content-y: (lyrics-autoscroll && active-lyric-index >= 0)
                    ? -min(max(0px, base-target + focus-offset), max(0px, self.content-height - self.visible-height))
                    : 0px;
                animate content-y { duration: Theme.reduced-motion ? 0ms : 320ms / max(0.5, lyrics-speed); easing: cubic-bezier(0.2, 0, 0, 1); }

                VerticalLayout {
                    spacing: 8px;
                    padding-top: max(12px, rp-scroll.visible-height * 0.42);
                    padding-bottom: max(64px, rp-scroll.visible-height * 0.48);

                    for line in lyrics-lines: Rectangle {
                        border-radius: 8px;
                        background: lta.has-hover ? #ffffff12 : transparent;
                        animate background { duration: 140ms; easing: ease-out; }

                        HorizontalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-right: 8px;
                            padding-left: line.is_active ? 12px : 8px;
                            spacing: 8px;
                            animate padding-left { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                            if line.is_gap: Image {
                                source: @image-url("icons/music_note.svg");
                                width: 18px;
                                height: 18px;
                                colorize: line.is_active ? Theme.primary : Theme.text-muted;
                            }

                            // Line mode OR inactive/gap line
                            if line.is_gap || lyrics-mode != "Word" || line.rows.length == 0: Text {
                                horizontal-stretch: 1;
                                text: line.is_gap ? "Instrumental" : line.text;
                                color: line.is_active ? Theme.text-primary : (line.is_past ? #e2e2e988 : Theme.text-muted);
                                font-size: line.is_active ? 18.5px : 15px;
                                font-weight: line.is_active ? 700 : 500;
                                wrap: word-wrap;
                                animate color { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }
                                animate font-size { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                            }

                            // Word-by-word karaoke mode (Gradient sweep or Words highlight)
                            if !line.is_gap && lyrics-mode == "Word" && line.rows.length > 0: VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;

                                for row in line.rows: HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;

                                    for w in row.words: Rectangle {
                                        width: rp-w-base.preferred-width;
                                        height: rp-w-base.preferred-height;

                                        rp-w-base := Text {
                                            text: w.text;
                                            color: line.is_active
                                                ? (lyrics-word-style == "words"
                                                    ? (w.is_past ? #ffffff : (w.is_active ? Theme.primary : #ffffff55))
                                                    : #ffffff55)
                                                : (line.is_past ? #e2e2e988 : Theme.text-muted);
                                            font-size: line.is_active ? 18.5px : 15px;
                                            font-weight: line.is_active ? 700 : 500;
                                            y: (line.is_active && lyrics-word-style == "words" && w.is_active) ? -1.5px : 0px;
                                            animate y { duration: Theme.reduced-motion ? 0ms : 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                            animate color { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }
                                            animate font-size { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                        }

                                        if line.is_active && lyrics-word-style != "words": Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width * clamp(w.progress, 0.0, 1.0);
                                            height: parent.height;
                                            clip: true;

                                            Text {
                                                x: 0px;
                                                y: 0px;
                                                width: rp-w-base.width;
                                                height: rp-w-base.height;
                                                text: w.text;
                                                color: #ffffff;
                                                font-size: 18.5px;
                                                font-weight: 700;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        lta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.seek-to(line.time_sec); }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsModal inherits Rectangle {
    in property <bool> open: false;
    in-out property <int> section: 0; // 0..9 nav items, 10: Account
    in-out property <string> eq-preset-name: "Default";
    in-out property <float> eq-bass: 0.0;
    in-out property <float> eq-mid: 0.0;
    in-out property <float> eq-treble: 0.0;
    in-out property <float> audio-speed: 1.0;
    in-out property <float> audio-reverb: 0.0;
    in-out property <float> audio-distortion: 0.0;
    in property <string> status-message: "";

    // Live UI & Visual Settings
    in-out property <bool> show-visualizer: true;
    in-out property <float> visualizer-opacity: 0.08;
    in-out property <bool> auto-hide-titlebar: true;
    in-out property <bool> show-timestamps: true;
    in-out property <bool> rp-banner-enabled: true;
    in-out property <bool> rp-gradient-enabled: true;
    in-out property <bool> tvk-blobs-enabled: true;
    in-out property <string> search-platform: "ytmusic";
    in-out property <bool> autoplay-enabled: true;
    in-out property <string> autoplay-mode: "similar";

    // Lyrics Settings
    in-out property <string> lyrics-source: "auto";
    in-out property <string> lyrics-word-source: "auto";
    in-out property <string> lyrics-mode: "Word";
    in-out property <string> lyrics-word-style: "gradient";
    in-out property <bool> lyrics-warnings: true;
    in-out property <bool> lyrics-autoscroll: true;
    in-out property <bool> lyrics-fullscreen-only: false;
    in-out property <float> lyrics-speed: 1.0;
    in-out property <float> lyrics-tightness: 2.0;
    in-out property <string> lyrics-ease: "inout";
    in-out property <string> lyrics-focus-pos: "center";
    in-out property <float> lyrics-offset-ms: 0.0;

    in property <int> local-count: 0;
    in property <int> fav-count: 0;
    in property <int> hist-count: 0;
    in property <int> playlist-count: 0;

    callback switch-ui-mode(string);
    callback scan-folder();
    callback add-files();
    callback apply-preset(string);
    callback set-eq(float, float, float);
    callback set-speed(float);
    callback set-effects(float, float);
    callback reset-audio();
    callback change-lyrics-source(string);
    callback change-word-source(string);
    callback set-lyrics-offset(float);
    callback clear-history();
    callback clear-queue();
    callback refresh-home();
    callback open-audio-editor();
    callback open-fullscreen-lyrics();
    callback toggle-mini-mode();
    callback toggle-autoplay(bool);
    callback change-autoplay-mode(string);
    callback save-setting(string, string);
    callback close();

    property <bool> native-ui-enabled: true;
    property <string> settings-search: "";

    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #00000085;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    // Swallow clicks on backdrop
    TouchArea {
        clicked => { root.close(); }
    }

    // Modal card (persis web_settings.png: min(1060px, 94vw) x min(750px, 88vh), radius 28px, translucent blur)
    Rectangle {
        width: min(1060px, parent.width * 0.94);
        height: min(750px, parent.height * 0.88);
        x: (parent.width - self.width) / 2;
        y: open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 28px;
        border-radius: 28px;
        background: #18191cb8;
        backdrop-blur: Theme.ambient-blur-enabled ? 28px : 0px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #00000099;
        clip: true;
        animate y { duration: Theme.reduced-motion ? 0ms : 280ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        // Prevent backdrop click inside modal
        TouchArea {}

        HorizontalLayout {
            // Left settings nav (256px, persis web_settings.png)
            Rectangle {
                width: 256px;
                background: #121316c4;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 18px;
                    padding-bottom: 14px;
                    spacing: 8px;

                    // Search settings pill (interactive)
                    Rectangle {
                        height: 40px;
                        border-radius: 20px;
                        background: s-input.has-focus ? #282930 : #1e1f24;
                        animate background { duration: 140ms; easing: ease-out; }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/search_stroke.svg"); width: 16px; height: 16px; colorize: Theme.text-secondary; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                if settings-search == "": Text {
                                    text: "Search settings...";
                                    color: Theme.text-muted;
                                    font-size: 13.5px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                s-input := TextInput {
                                    text <=> settings-search;
                                    color: Theme.text-primary;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => {
                                        if (settings-search == "theme" || settings-search == "color" || settings-search == "blur" || settings-search == "accent") { section = 1; }
                                        else if (settings-search == "banner" || settings-search == "gradient") { section = 2; }
                                        else if (settings-search == "eq" || settings-search == "audio" || settings-search == "speed" || settings-search == "reverb") { section = 3; }
                                        else if (settings-search == "youtube" || settings-search == "soundcloud" || settings-search == "search") { section = 4; }
                                        else if (settings-search == "storage" || settings-search == "folder" || settings-search == "files" || settings-search == "history") { section = 5; }
                                        else if (settings-search == "motion" || settings-search == "advanced") { section = 6; }
                                        else if (settings-search == "about" || settings-search == "version") { section = 7; }
                                        else if (settings-search == "plugin") { section = 9; }
                                        else if (settings-search == "account") { section = 10; }
                                    }
                                }
                            }
                        }
                    }

                    // Scrollable nav list with sliding active pill (.settings-nav-active-pill)
                    ScrollView {
                        vertical-stretch: 1;

                        Rectangle {
                            height: 520px;

                            // Sliding active pill (230ms ease-in-out)
                            Rectangle {
                                x: 0px;
                                y: section < 10 ? section * 52px : 0px;
                                width: parent.width;
                                height: 48px;
                                border-radius: 12px;
                                background: Theme.primary;
                                opacity: section < 10 ? 1.0 : 0.0;
                                animate y { duration: 230ms; easing: ease-in-out; }
                                animate opacity { duration: 140ms; easing: ease-in-out; }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                for nav in [
                                    { idx: 0, label: "Interface", icon: @image-url("icons/settings_interface.svg") },
                                    { idx: 1, label: "Theme", icon: @image-url("icons/settings_theme.svg") },
                                    { idx: 2, label: "Banners", icon: @image-url("icons/settings_banners.svg") },
                                    { idx: 3, label: "Tracks", icon: @image-url("icons/win_lyrics.svg") },
                                    { idx: 4, label: "Integrations", icon: @image-url("icons/settings_integrations.svg") },
                                    { idx: 5, label: "Storage", icon: @image-url("icons/settings_storage.svg") },
                                    { idx: 6, label: "Advanced", icon: @image-url("icons/ms_tune.svg") },
                                    { idx: 7, label: "About", icon: @image-url("icons/settings_about.svg") },
                                    { idx: 8, label: "Custom themes", icon: @image-url("icons/settings_theme.svg") },
                                    { idx: 9, label: "Plugins", icon: @image-url("icons/settings_plugins.svg") },
                                ]: Rectangle {
                                    height: 48px;
                                    border-radius: 12px;
                                    background: section == nav.idx ? transparent : (nta.has-hover ? #ffffff0d : transparent);
                                    animate background { duration: 140ms; easing: ease-out; }

                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 14px;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: nav.icon;
                                                width: 20px;
                                                height: 20px;
                                                colorize: section == nav.idx ? Theme.on-primary : Theme.text-secondary;
                                                animate colorize { duration: 160ms; easing: ease-out; }
                                            }
                                        }

                                        Text {
                                            text: nav.label;
                                            color: section == nav.idx ? Theme.on-primary : Theme.text-primary;
                                            font-size: 14.5px;
                                            font-weight: section == nav.idx ? 600 : 500;
                                            vertical-alignment: center;
                                            animate color { duration: 160ms; easing: ease-out; }
                                        }
                                    }

                                    nta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { section = nav.idx; }
                                    }
                                }
                            }
                        }
                    }

                    // Account footer (sticky bottom, persis web_settings.png)
                    Rectangle {
                        height: 52px;
                        border-radius: 12px;
                        background: section == 10 ? Theme.primary : (acc-ta.has-hover ? #ffffff0d : transparent);
                        animate background { duration: 140ms; easing: ease-out; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/avatar_default.svg"); width: 32px; height: 32px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "User";
                                    color: section == 10 ? Theme.on-primary : Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Account";
                                    color: section == 10 ? Theme.on-primary : Theme.text-muted;
                                    font-size: 12px;
                                }
                            }
                        }

                        acc-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { section = 10; }
                        }
                    }
                }
            }

            // Right settings pane (persis web_settings.png: .m3-group cards)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                ScrollView {
                    VerticalLayout {
                        padding-top: 28px;
                        padding-left: 32px;
                        padding-right: 68px;
                        padding-bottom: 40px;
                        spacing: 16px;
                        alignment: start;

                        // 0: Interface
                        if section == 0: VerticalLayout {
                            spacing: 14px;

                            Text { text: "Interface"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            VerticalLayout {
                                spacing: 6px;

                                // Top card
                                Rectangle {
                                    border-top-left-radius: 20px;
                                    border-top-right-radius: 20px;
                                    border-bottom-left-radius: 6px;
                                    border-bottom-right-radius: 6px;
                                    background: #202126b8;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Native Slint UI"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text {
                                                text: native-ui-enabled
                                                    ? "Active: Native Rust + Slint engine (toggle off to switch back to WebView2 on next launch)"
                                                    : "Switched to WebView2 UI — restart Riff to launch Web UI";
                                                color: Theme.text-muted;
                                                font-size: 12.5px;
                                                wrap: word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> native-ui-enabled;
                                                toggled(on) => {
                                                    root.switch-ui-mode(on ? "native" : "web");
                                                }
                                            }
                                        }
                                    }
                                }

                                // Show bottom wave visualizer
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Show wave visualizer in bottom bar"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Real-time 16-band FFT spectrum behind the playbar"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> show-visualizer;
                                                toggled(on) => { root.save-setting("slint_show_visualizer", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }

                                // Visualizer opacity
                                if show-visualizer: Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            Text { text: "Playbar visualizer opacity"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; }
                                            Text { text: Math.round(visualizer-opacity * 100) + "%"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                        }
                                        Slider {
                                            height: 30px;
                                            minimum: 0.02;
                                            maximum: 0.30;
                                            value <=> visualizer-opacity;
                                            changed(v) => { root.save-setting("slint_visualizer_opacity", Math.round(v * 100) + ""); }
                                        }
                                    }
                                }

                                // Auto-hide top titlebar
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Auto-hide top titlebar"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Reveal floating window controls when hovering the top edge"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> auto-hide-titlebar;
                                                toggled(on) => { root.save-setting("slint_auto_hide_titlebar", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }

                                // Show timestamps
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Show timeline timestamps"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Display elapsed and total duration beside the scrubber"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> show-timestamps;
                                                toggled(on) => { root.save-setting("slint_show_timestamps", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }

                                // Autoplay & Recommendations
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 16px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 3px;
                                                Text { text: "Autoplay recommendations"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                                Text { text: "Automatically queue and play recommended songs after a track ends"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                ToggleSwitch {
                                                    checked <=> autoplay-enabled;
                                                    toggled(on) => { root.toggle-autoplay(on); }
                                                }
                                            }
                                        }
                                        if autoplay-enabled: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            for apm in [
                                                { id: "similar", label: "Similar Vibe" },
                                                { id: "artist", label: "Artist Mix" },
                                                { id: "discovery", label: "Discovery" },
                                            ]: PillBtn {
                                                label: apm.label;
                                                btn-height: 28px;
                                                h-pad: 11px;
                                                primary: autoplay-mode == apm.id;
                                                clicked => {
                                                    autoplay-mode = apm.id;
                                                    root.change-autoplay-mode(apm.id);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Compact mini player
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Compact mini player"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Switch between full desktop layout and compact mini window"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn {
                                                label: "Toggle mini";
                                                clicked => { root.close(); root.toggle-mini-mode(); }
                                            }
                                        }
                                    }
                                }

                                // Bottom card
                                Rectangle {
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-bottom-left-radius: 20px;
                                    border-bottom-right-radius: 20px;
                                    background: #202126b8;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "WebView2 Classic UI"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Switch ui_mode back to WebView2 (takes effect on next launch)"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn {
                                                label: "Use Web UI";
                                                clicked => {
                                                    native-ui-enabled = false;
                                                    root.switch-ui-mode("web");
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 1: Theme
                        if section == 1: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Theme"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            VerticalLayout {
                                spacing: 6px;

                                // Accent color swatches
                                Rectangle {
                                    border-top-left-radius: 20px;
                                    border-top-right-radius: 20px;
                                    border-bottom-left-radius: 6px;
                                    border-bottom-right-radius: 6px;
                                    background: #202126b8;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        Text { text: "Accent color"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            for sw in [
                                                { id: "purple", col: #9f99e6, on: #1e1a4d },
                                                { id: "indigo", col: #7c8cff, on: #12184a },
                                                { id: "blue", col: #64b5f6, on: #0d2b45 },
                                                { id: "teal", col: #4db6ac, on: #0b332f },
                                                { id: "green", col: #81c784, on: #123815 },
                                                { id: "amber", col: #ffb74d, on: #3d2600 },
                                                { id: "rose", col: #f06292, on: #4a0d24 },
                                                { id: "mono", col: #e2e2e9, on: #121214 },
                                            ]: Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 16px;
                                                background: sw.col;
                                                border-width: Theme.custom-accent == sw.col ? 3px : 0px;
                                                border-color: #ffffff;
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        Theme.custom-accent = sw.col;
                                                        Theme.custom-on-accent = sw.on;
                                                        Theme.primary = sw.col;
                                                        Theme.on-primary = sw.on;
                                                        root.save-setting("slint_accent", sw.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Dynamic cover accent
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Dynamic cover accent"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Extract dominant accent color from the currently playing track cover"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> Theme.dynamic-accent-enabled;
                                                toggled(on) => {
                                                    if (!on) {
                                                        Theme.primary = Theme.custom-accent;
                                                        Theme.on-primary = Theme.custom-on-accent;
                                                    }
                                                    root.save-setting("slint_dynamic_accent", on ? "1" : "0");
                                                }
                                            }
                                        }
                                    }
                                }

                                // Ambient cover blur
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Ambient cover blur"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Soft blurred album artwork backdrop behind translucent glass panels"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> Theme.ambient-blur-enabled;
                                                toggled(on) => { root.save-setting("slint_ambient_blur", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }

                                // Panel glass opacity
                                Rectangle {
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-bottom-left-radius: 20px;
                                    border-bottom-right-radius: 20px;
                                    background: #202126b8;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            Text { text: "Panel glass opacity"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; }
                                            Text { text: Math.round(Theme.panel-opacity * 100) + "%"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                        }
                                        Slider {
                                            height: 30px;
                                            minimum: 0.50;
                                            maximum: 1.0;
                                            value <=> Theme.panel-opacity;
                                            changed(v) => { root.save-setting("slint_panel_opacity", Math.round(v * 100) + ""); }
                                        }
                                    }
                                }
                            }
                        }

                        // 2: Banners
                        if section == 2: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Banners"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    border-top-left-radius: 20px;
                                    border-top-right-radius: 20px;
                                    border-bottom-left-radius: 6px;
                                    border-bottom-right-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Now Playing cover banner"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Show blurred track artwork fading across the top of the right panel"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> rp-banner-enabled;
                                                toggled(on) => { root.save-setting("slint_rp_banner", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Now Playing ambient gradient"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Automatically tints the right panel header from track artwork"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> rp-gradient-enabled;
                                                toggled(on) => { root.save-setting("slint_rp_gradient", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-bottom-left-radius: 20px;
                                    border-bottom-right-radius: 20px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Fullscreen karaoke orbiting blobs"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Animated ambient color blobs behind fullscreen synced lyrics"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> tvk-blobs-enabled;
                                                toggled(on) => { root.save-setting("slint_tvk_blobs", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 3: Tracks (Audio, Speed, FX & EQ)
                        if section == 3: VerticalLayout {
                            spacing: 14px;

                            HorizontalLayout {
                                Text { text: "Tracks & Audio"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                                PillBtn { label: "Reset audio"; btn-height: 28px; clicked => { root.reset-audio(); } }
                            }

                            Rectangle {
                                border-top-left-radius: 20px;
                                border-top-right-radius: 20px;
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                                background: #202126b8;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    Text { text: "Audio Presets"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        for p in [
                                            { id: "p_default", label: "Default" },
                                            { id: "p_speedup", label: "Speed up" },
                                            { id: "p_slowed", label: "Slowed + reverb" },
                                            { id: "p_nightcore", label: "Nightcore" },
                                            { id: "p_distortion", label: "Distortion" },
                                        ]: PillBtn {
                                            label: p.label;
                                            primary: eq-preset-name == p.label;
                                            clicked => {
                                                eq-preset-name = p.label;
                                                root.apply-preset(p.id);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 6px;
                                background: #202126b8;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: "Playback Speed"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; }
                                        Text { text: Math.round(audio-speed * 100) / 100 + "x"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                    }
                                    Slider { height: 30px; minimum: 0.5; maximum: 2.0; value <=> audio-speed; changed(v) => { root.set-speed(v); } }

                                    HorizontalLayout {
                                        Text { text: "Reverb"; color: Theme.text-secondary; font-size: 13px; horizontal-stretch: 1; }
                                        Text { text: Math.round(audio-reverb) + "%"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                    }
                                    Slider { height: 30px; minimum: 0.0; maximum: 100.0; value <=> audio-reverb; changed(v) => { root.set-effects(v, audio-distortion); } }

                                    HorizontalLayout {
                                        Text { text: "Distortion"; color: Theme.text-secondary; font-size: 13px; horizontal-stretch: 1; }
                                        Text { text: Math.round(audio-distortion) + "%"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                    }
                                    Slider { height: 30px; minimum: 0.0; maximum: 100.0; value <=> audio-distortion; changed(v) => { root.set-effects(audio-reverb, v); } }
                                }
                            }

                            Rectangle {
                                border-radius: 6px;
                                background: #202126b8;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "3-Band Equalizer"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }

                                    Text { text: "Bass (100Hz): " + Math.round(eq-bass) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                    Slider { height: 30px; minimum: -12.0; maximum: 12.0; value <=> eq-bass; changed(v) => { root.set-eq(v, eq-mid, eq-treble); } }

                                    Text { text: "Mid (1kHz): " + Math.round(eq-mid) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                    Slider { height: 30px; minimum: -12.0; maximum: 12.0; value <=> eq-mid; changed(v) => { root.set-eq(eq-bass, v, eq-treble); } }

                                    Text { text: "Treble (8kHz): " + Math.round(eq-treble) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                    Slider { height: 30px; minimum: -12.0; maximum: 12.0; value <=> eq-treble; changed(v) => { root.set-eq(eq-bass, eq-mid, v); } }
                                }
                            }

                            // Lyrics Settings Card (1:1 Web UI)
                            Rectangle {
                                border-top-left-radius: 6px;
                                border-top-right-radius: 6px;
                                border-bottom-left-radius: 20px;
                                border-bottom-right-radius: 20px;
                                background: #202126b8;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 12px;

                                    Text { text: "Lyrics & Sync"; color: Theme.text-primary; font-size: 15px; font-weight: 700; }

                                    // Lyrics source
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Lyrics source"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                        Text { text: "Preferred lyrics provider with automatic fallback"; color: Theme.text-muted; font-size: 12px; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            for src in [
                                                { id: "auto", label: "Auto" },
                                                { id: "lrclib", label: "LRCLIB" },
                                                { id: "musixmatch", label: "Musixmatch" },
                                                { id: "kugou", label: "Kugou LRC" },
                                                { id: "netease", label: "NetEase" },
                                                { id: "genius", label: "Genius" },
                                            ]: PillBtn {
                                                label: src.label;
                                                btn-height: 30px;
                                                primary: lyrics-source == src.id;
                                                clicked => {
                                                    lyrics-source = src.id;
                                                    root.change-lyrics-source(src.id);
                                                }
                                            }
                                        }
                                    }

                                    // Word-by-word source
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Word-by-word source"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                        Text { text: "Source for karaoke word-by-word timings"; color: Theme.text-muted; font-size: 12px; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            for ws in [
                                                { id: "auto", label: "Auto" },
                                                { id: "netease", label: "NetEase YRC" },
                                                { id: "estimate", label: "Estimate" },
                                            ]: PillBtn {
                                                label: ws.label;
                                                btn-height: 30px;
                                                primary: lyrics-word-source == ws.id;
                                                clicked => {
                                                    lyrics-word-source = ws.id;
                                                    root.change-word-source(ws.id);
                                                }
                                            }
                                        }
                                    }

                                    // Lyrics mode & Word style
                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            Text { text: "Lyrics mode"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                PillBtn {
                                                    label: "Word";
                                                    btn-height: 30px;
                                                    primary: lyrics-mode == "Word";
                                                    clicked => { lyrics-mode = "Word"; root.save-setting("slint_lyrics_mode", "Word"); }
                                                }
                                                PillBtn {
                                                    label: "Line";
                                                    btn-height: 30px;
                                                    primary: lyrics-mode == "Line";
                                                    clicked => { lyrics-mode = "Line"; root.save-setting("slint_lyrics_mode", "Line"); }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 6px;
                                            Text { text: "Word mode style"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                PillBtn {
                                                    label: "Gradient";
                                                    btn-height: 30px;
                                                    primary: lyrics-word-style == "gradient";
                                                    clicked => { lyrics-word-style = "gradient"; root.save-setting("slint_lyrics_word_style", "gradient"); }
                                                }
                                                PillBtn {
                                                    label: "Words";
                                                    btn-height: 30px;
                                                    primary: lyrics-word-style == "words";
                                                    clicked => { lyrics-word-style = "words"; root.save-setting("slint_lyrics_word_style", "words"); }
                                                }
                                            }
                                        }
                                    }

                                    // Toggles
                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: "Show 'No lyrics / No sync' warnings"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                            Text { text: "Display sync & source status badge in Now Playing"; color: Theme.text-muted; font-size: 12px; }
                                        }
                                        ToggleSwitch {
                                            checked <=> lyrics-warnings;
                                            toggled(on) => { root.save-setting("slint_lyrics_warnings", on ? "1" : "0"); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: "Auto-scroll lyrics"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                            Text { text: "Automatically follow the active lyric line during playback"; color: Theme.text-muted; font-size: 12px; }
                                        }
                                        ToggleSwitch {
                                            checked <=> lyrics-autoscroll;
                                            toggled(on) => { root.save-setting("slint_lyrics_autoscroll", on ? "1" : "0"); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: "Show lyrics only in fullscreen mode"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                            Text { text: "Hide lyrics in the right panel and show them in fullscreen karaoke"; color: Theme.text-muted; font-size: 12px; }
                                        }
                                        ToggleSwitch {
                                            checked <=> lyrics-fullscreen-only;
                                            toggled(on) => { root.save-setting("slint_lyrics_fullscreen_only", on ? "1" : "0"); }
                                        }
                                    }

                                    // Active lyric vertical position (Top / Center / Bottom)
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Active lyric position"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            for fp in [
                                                { id: "top", label: "Top" },
                                                { id: "center", label: "Center" },
                                                { id: "bottom", label: "Bottom" },
                                            ]: PillBtn {
                                                label: fp.label;
                                                btn-height: 28px;
                                                h-pad: 12px;
                                                primary: lyrics-focus-pos == fp.id;
                                                clicked => {
                                                    lyrics-focus-pos = fp.id;
                                                    root.save-setting("slint_lyrics_focus_pos", fp.id);
                                                }
                                            }
                                        }
                                    }

                                    // Lyrics animation easing (matches origin lyrics-ease-dropdown)
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Lyrics animation"; color: Theme.text-primary; font-size: 13.5px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            for ez in [
                                                { id: "inout", label: "Ease in-out" },
                                                { id: "quad", label: "Smooth" },
                                                { id: "sine", label: "Gentle" },
                                                { id: "out", label: "Ease out" },
                                                { id: "expo", label: "Snappy" },
                                                { id: "linear", label: "Linear" },
                                            ]: PillBtn {
                                                label: ez.label;
                                                btn-height: 28px;
                                                h-pad: 10px;
                                                primary: lyrics-ease == ez.id;
                                                clicked => {
                                                    lyrics-ease = ez.id;
                                                    root.save-setting("slint_lyrics_ease", ez.id);
                                                }
                                            }
                                        }
                                    }

                                    // Sync timing offset
                                    HorizontalLayout {
                                        Text { text: "Lyrics sync offset"; color: Theme.text-secondary; font-size: 13px; horizontal-stretch: 1; }
                                        Text { text: (lyrics-offset-ms >= 0 ? "+" : "") + Math.round(lyrics-offset-ms) + " ms"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                    }
                                    Slider {
                                        height: 28px;
                                        minimum: -3000.0;
                                        maximum: 3000.0;
                                        value <=> lyrics-offset-ms;
                                        changed(v) => { root.set-lyrics-offset(v); }
                                    }

                                    // Lyrics animation speed
                                    HorizontalLayout {
                                        Text { text: "Lyrics animation speed"; color: Theme.text-secondary; font-size: 13px; horizontal-stretch: 1; }
                                        Text { text: Math.round(lyrics-speed * 10) / 10 + "x"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                    }
                                    Slider {
                                        height: 28px;
                                        minimum: 0.5;
                                        maximum: 2.5;
                                        value <=> lyrics-speed;
                                        changed(v) => { root.save-setting("slint_lyrics_speed", Math.round(v * 10) + ""); }
                                    }

                                    // Gradient tightness
                                    HorizontalLayout {
                                        Text { text: "Gradient tightness"; color: Theme.text-secondary; font-size: 13px; horizontal-stretch: 1; }
                                        Text { text: Math.round(lyrics-tightness) + "%"; color: Theme.primary; font-size: 13px; font-weight: 700; }
                                    }
                                    Slider {
                                        height: 28px;
                                        minimum: 2.0;
                                        maximum: 24.0;
                                        value <=> lyrics-tightness;
                                        changed(v) => { root.save-setting("slint_lyrics_tightness", Math.round(v) + ""); }
                                    }
                                }
                            }
                        }

                        // 4: Integrations
                        if section == 4: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Integrations"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    border-top-left-radius: 20px;
                                    border-top-right-radius: 20px;
                                    border-bottom-left-radius: 6px;
                                    border-bottom-right-radius: 6px;
                                    background: #202126b8;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        Text { text: "Default search engine"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            for eng in [
                                                { id: "ytmusic", label: "YouTube Music" },
                                                { id: "soundcloud", label: "SoundCloud" },
                                                { id: "local", label: "Local" },
                                            ]: PillBtn {
                                                label: eng.label;
                                                primary: search-platform == eng.id;
                                                clicked => {
                                                    search-platform = eng.id;
                                                    root.save-setting("slint_search_platform", eng.id);
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "YouTube Music"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Native Rust search, trending charts, and stream resolver"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn { label: "Refresh feed"; btn-height: 30px; clicked => { root.refresh-home(); } }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-bottom-left-radius: 20px;
                                    border-bottom-right-radius: 20px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "SoundCloud"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Native Rust search, Smart Mirror, and HLS/MP3 resolver"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        Text { text: "Connected"; color: Theme.primary; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // 5: Storage
                        if section == 5: VerticalLayout {
                            spacing: 14px;

                            Text { text: "Storage"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    border-top-left-radius: 20px;
                                    border-top-right-radius: 20px;
                                    border-bottom-left-radius: 6px;
                                    border-bottom-right-radius: 6px;
                                    background: #202126b8;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Add audio files"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Import individual MP3, FLAC, WAV, OGG, or M4A files (" + local-count + " in library)"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn {
                                                label: "Add files";
                                                primary: true;
                                                clicked => { root.add-files(); }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Scan music folder"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Recursively scan a directory into your local library"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn {
                                                label: "Add folder";
                                                clicked => { root.scan-folder(); }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-bottom-left-radius: 20px;
                                    border-bottom-right-radius: 20px;
                                    background: #202126b8;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Playback data"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: hist-count + " history • " + fav-count + " liked • " + playlist-count + " playlists"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn { label: "Clear history"; clicked => { root.clear-history(); } }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn { label: "Clear queue"; clicked => { root.clear-queue(); } }
                                        }
                                    }
                                }
                            }
                        }

                        // 6: Advanced
                        if section == 6: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Advanced"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    border-top-left-radius: 20px;
                                    border-top-right-radius: 20px;
                                    border-bottom-left-radius: 6px;
                                    border-bottom-right-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Reduced motion"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Minimize UI transitions, hover lifts, and animated equalizer bars"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> Theme.reduced-motion;
                                                toggled(on) => { root.save-setting("slint_reduced_motion", on ? "1" : "0"); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 6px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Native Slint UI"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: "Use native Rust + Slint renderer instead of WebView2"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ToggleSwitch {
                                                checked <=> native-ui-enabled;
                                                toggled(on) => { root.switch-ui-mode(on ? "native" : "web"); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-bottom-left-radius: 20px;
                                    border-bottom-right-radius: 20px;
                                    background: #202126b8;
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: "Audio Engine"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                            Text { text: status-message; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn { label: "Audio Editor"; clicked => { root.close(); root.open-audio-editor(); } }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillBtn { label: "Karaoke"; clicked => { root.close(); root.open-fullscreen-lyrics(); } }
                                        }
                                    }
                                }
                            }
                        }

                        // 7: About
                        if section == 7: VerticalLayout {
                            spacing: 14px;

                            Text { text: "About"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }

                            Rectangle {
                                border-top-left-radius: 20px;
                                border-top-right-radius: 20px;
                                border-bottom-left-radius: 6px;
                                border-bottom-right-radius: 6px;
                                background: #202126b8;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 4px;
                                    Text { text: "Riff v0.7.6 (Native Slint Engine)"; color: Theme.text-primary; font-size: 15px; font-weight: 700; }
                                    Text { text: status-message; color: Theme.text-muted; font-size: 12.5px; }
                                }
                            }

                            Rectangle {
                                border-top-left-radius: 6px;
                                border-top-right-radius: 6px;
                                border-bottom-left-radius: 20px;
                                border-bottom-right-radius: 20px;
                                background: #202126b8;
                                VerticalLayout {
                                    padding: 16px;
                                    AboutSlint {}
                                }
                            }
                        }

                        // 8: Custom themes
                        if section == 8: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Custom themes"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }
                            Rectangle {
                                border-radius: 20px;
                                background: #202126b8;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    Text { text: "Quick Theme Presets"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                    Text { text: "Apply curated Material You & glass presets instantly"; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        PillBtn {
                                            label: "Riff Purple";
                                            primary: Theme.custom-accent == #9f99e6;
                                            clicked => {
                                                Theme.custom-accent = #9f99e6; Theme.custom-on-accent = #1e1a4d;
                                                Theme.primary = #9f99e6; Theme.on-primary = #1e1a4d;
                                                Theme.panel-bg = #0d0d0d; Theme.panel-opacity = 0.76;
                                                root.save-setting("slint_accent", "purple");
                                            }
                                        }
                                        PillBtn {
                                            label: "Midnight OLED";
                                            primary: Theme.panel-bg == #050507;
                                            clicked => {
                                                Theme.panel-bg = #050507; Theme.window-bg = #000000;
                                                Theme.panel-opacity = 0.88;
                                                root.save-setting("slint_panel_opacity", "88");
                                            }
                                        }
                                        PillBtn {
                                            label: "Ocean Glass";
                                            primary: Theme.custom-accent == #64b5f6;
                                            clicked => {
                                                Theme.custom-accent = #64b5f6; Theme.custom-on-accent = #0d2b45;
                                                Theme.primary = #64b5f6; Theme.on-primary = #0d2b45;
                                                Theme.panel-bg = #0d0d0d; Theme.window-bg = #2b2b2e;
                                                Theme.panel-opacity = 0.68;
                                                root.save-setting("slint_accent", "blue");
                                                root.save-setting("slint_panel_opacity", "68");
                                            }
                                        }
                                        PillBtn {
                                            label: "Rose Velvet";
                                            primary: Theme.custom-accent == #f06292;
                                            clicked => {
                                                Theme.custom-accent = #f06292; Theme.custom-on-accent = #4a0d24;
                                                Theme.primary = #f06292; Theme.on-primary = #4a0d24;
                                                Theme.panel-bg = #0d0d0d; Theme.window-bg = #2b2b2e;
                                                Theme.panel-opacity = 0.74;
                                                root.save-setting("slint_accent", "rose");
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 9: Plugins
                        if section == 9: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Plugins"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }
                            Rectangle {
                                border-radius: 20px;
                                background: #202126b8;
                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 16px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "JavaScript Plugins"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                        Text { text: "JS plugins run in WebView2 mode. Switch to Web UI to manage JS plugins."; color: Theme.text-muted; font-size: 12.5px; wrap: word-wrap; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        PillBtn {
                                            label: "Use Web UI";
                                            clicked => {
                                                native-ui-enabled = false;
                                                root.switch-ui-mode("web");
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 10: Account
                        if section == 10: VerticalLayout {
                            spacing: 14px;
                            Text { text: "Account"; color: Theme.text-secondary; font-size: 14px; font-weight: 600; }
                            Rectangle {
                                border-radius: 20px;
                                background: #202126b8;
                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 14px;
                                    Image { source: @image-url("icons/avatar_default.svg"); width: 44px; height: 44px; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: "User"; color: Theme.text-primary; font-size: 15px; font-weight: 700; }
                                        Text { text: "Local Riff profile • " + fav-count + " liked • " + playlist-count + " playlists"; color: Theme.text-muted; font-size: 12.5px; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Close button (X) ESC di kanan atas modal (persis web_settings.png)
        VerticalLayout {
            x: parent.width - 56px;
            y: 20px;
            width: 36px;
            spacing: 4px;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                border-width: 2px;
                border-color: cta.has-hover ? Theme.text-primary : #8e909999;
                background: cta.has-hover ? #ffffff18 : transparent;
                animate background { duration: 150ms; easing: ease-out; }
                animate border-color { duration: 150ms; easing: ease-out; }

                Image {
                    source: @image-url("icons/ms_close.svg");
                    width: 18px;
                    height: 18px;
                    colorize: cta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    x: 9px;
                    y: 9px;
                }

                cta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }

            Text {
                text: "ESC";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }
}

// ============================================================================
// FULLSCREEN SYNC LYRICS / KARAOKE (#tv-karaoke 1:1)
// ============================================================================
export component FullscreenLyricsOverlay inherits Rectangle {
    in property <bool> open: false;
    in property <string> current-id: "";
    in property <string> current-title: "No track playing";
    in property <string> current-artist: "Select a track to listen";
    in property <image> current-cover;
    in property <bool> current-has-cover: false;
    in property <image> current-cover-blur;
    in property <bool> current-has-blur: false;
    in property <color> accent-color: Theme.primary;
    in property <bool> is-playing: false;
    in property <float> current-pos: 0.0;
    in property <float> current-duration: 1.0;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <bool> shuffle-on: false;
    in property <int> repeat-mode: 0; // 0: off, 1: all, 2: one
    in property <[LyricLineData]> lyrics-lines: [];
    in property <int> active-lyric-index: -1;
    in property <[float]> spectrum-bands: [];
    in property <bool> blobs-enabled: true;
    in-out property <string> lyrics-mode: "Word";
    in-out property <string> lyrics-word-style: "gradient";
    in-out property <string> lyrics-source: "auto";
    in property <string> lyrics-source-label: "Auto";
    in property <bool> lyrics-is-synced: false;
    in property <bool> lyrics-autoscroll: true;
    in property <float> lyrics-speed: 1.0;
    in property <string> lyrics-focus-pos: "center";
    in-out property <float> lyrics-offset-ms: 0.0;

    // Customize panel state (#tvk-panel)
    in-out property <bool> settings-panel-open: false;
    in-out property <bool> cover-only-mode: false;
    in-out property <int> tvk-align: 1; // 0: left, 1: center, 2: right
    in-out property <float> tvk-size-pct: 100.0;
    in-out property <int> tvk-weight: 700;
    in-out property <float> tvk-gap: 16.0;
    in-out property <bool> tvk-vis-nolyrics: true;
    in-out property <bool> tvk-vis-lyrics: true;
    in-out property <float> tvk-vis-opacity: 0.85;

    callback toggle-play-pause();
    callback play-prev();
    callback play-next();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback seek-to(float);
    callback edit-lyrics();
    callback sync-lyrics();
    callback change-lyrics-source(string);
    callback set-lyrics-offset(float);
    callback save-setting(string, string);
    callback close();

    property <bool> show-lyrics-col: lyrics-lines.length > 0 && !cover-only-mode;
    property <float> t-sec: open ? (animation-tick() / 1s) : 0.0;

    y: open ? 0px : 36px;
    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #0a0a0e;
    clip: true;
    animate y { duration: Theme.reduced-motion ? 0ms : 340ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    animate opacity { duration: Theme.reduced-motion ? 0ms : 280ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    // Swallow clicks
    TouchArea {}

    // Ambient blurred cover + orbiting color blobs (#tvk-ambient-bg)
    if current-has-blur: Image {
        source: current-cover-blur;
        width: parent.width * 1.25;
        height: parent.height * 1.25;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: cover;
        opacity: 0.62;
    }

    // Orbiting ambient blobs (tvkOrbit1..3)
    if blobs-enabled: Rectangle {
        width: parent.width * 0.72;
        height: parent.width * 0.72;
        border-radius: self.width / 2;
        x: -self.width * 0.22 + Math.sin(t-sec * 0.37rad) * 60px;
        y: -self.height * 0.24 + Math.cos(t-sec * 0.29rad) * 45px;
        background: @radial-gradient(circle, accent-color.with-alpha(0.38) 0%, transparent 70%);
    }
    if blobs-enabled: Rectangle {
        width: parent.width * 0.68;
        height: parent.width * 0.68;
        border-radius: self.width / 2;
        x: parent.width - self.width * 0.75 + Math.cos(t-sec * 0.45rad) * 55px;
        y: parent.height - self.height * 0.72 + Math.sin(t-sec * 0.33rad) * 50px;
        background: @radial-gradient(circle, Theme.primary.with-alpha(0.28) 0%, transparent 70%);
    }

    // Subtle vignette overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #00000030 0%, #00000018 50%, #00000055 100%);
    }

    // Bottom FFT Visualizer (#tvk-visualizer)
    if (show-lyrics-col ? tvk-vis-lyrics : tvk-vis-nolyrics): HorizontalLayout {
        x: 0px;
        y: parent.height - 160px;
        width: 100%;
        height: 160px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        opacity: tvk-vis-opacity * 0.22;

        for band in spectrum-bands: VerticalLayout {
            horizontal-stretch: 1;
            alignment: end;
            Rectangle {
                height: max(4px, min(150px, band * 150px));
                border-radius: 4px;
                background: #ffffff;
                animate height { duration: 85ms; easing: ease-out; }
            }
        }
    }

    // Main layout (.tv-karaoke-layout)
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: show-lyrics-col ? 64px : 40px;
        padding-right: show-lyrics-col ? 64px : 40px;
        padding-top: 56px;
        padding-bottom: 48px;
        spacing: show-lyrics-col ? 56px : 0px;

        if !show-lyrics-col: Rectangle { horizontal-stretch: 1; }

        // Left side (.tv-side)
        VerticalLayout {
            width: show-lyrics-col ? 360px : 420px;
            alignment: center;
            spacing: 18px;

            // Large album cover (.tv-cover)
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: show-lyrics-col ? 320px : 360px;
                    height: self.width;
                    border-radius: 28px;
                    background: #141418;
                    drop-shadow-blur: 36px;
                    drop-shadow-offset-y: 14px;
                    drop-shadow-color: #00000088;
                    clip: true;

                    if current-has-cover: Image {
                        source: current-cover;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                    if !current-has-cover: Image {
                        source: @image-url("icons/play_circle.svg");
                        width: 56px;
                        height: 56px;
                        colorize: #ffffff66;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Title & Artist (.tv-karaoke-meta)
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: current-title;
                    color: #ffffff;
                    font-size: show-lyrics-col ? 24px : 28px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: current-artist;
                    color: #ffffffbf;
                    font-size: show-lyrics-col ? 16px : 18px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Audio output & Lyrics Sync/Source badges (.tvk-output)
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: #ffffff14;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Image { source: @image-url("icons/headset.svg"); width: 14px; height: 14px; colorize: #ffffffcc; }
                        }
                        Text { text: "WASAPI 44.1kHz"; color: #ffffffcc; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                    }
                }
                if current-id != "": Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: tvk-src-ta.has-hover ? #ffffff26 : #ffffff14;
                    animate background { duration: 140ms; easing: ease-out; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: lyrics-lines.length == 0 ? #f28b82 : (lyrics-is-synced ? #81c784 : #ffb74d);
                            }
                        }
                        Text {
                            text: lyrics-lines.length == 0
                                ? "No lyrics"
                                : (lyrics-is-synced ? (lyrics-mode + " • " + lyrics-source-label) : ("Unsynced • " + lyrics-source-label));
                            color: #ffffffcc;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    tvk-src-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { settings-panel-open = !settings-panel-open; }
                    }
                }
            }

            // Progress scrubber (.tvk-progress-row)
            HorizontalLayout {
                height: 28px;
                spacing: 12px;
                Text {
                    width: 38px;
                    text: pos-text;
                    color: #ffffff99;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                ScrubberBar {
                    horizontal-stretch: 1;
                    active: current-id != "";
                    value: current-pos;
                    maximum: current-duration;
                    seeked(pos) => { root.seek-to(pos); }
                }
                Text {
                    width: 38px;
                    text: dur-text;
                    color: #ffffff99;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Playback controls (.tvk-controls)
            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                height: 56px;

                IconBtn {
                    width: 40px;
                    height: 40px;
                    icon: @image-url("icons/shuffle.svg");
                    icon-size: 18px;
                    icon-color: shuffle-on ? Theme.primary : #ffffff8c;
                    clicked => { root.toggle-shuffle(); }
                }
                IconBtn {
                    width: 40px;
                    height: 40px;
                    icon: @image-url("icons/prev_fill.svg");
                    icon-size: 20px;
                    icon-color: #ffffffcc;
                    clicked => { root.play-prev(); }
                }
                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 28px;
                    background: pta.has-hover ? #ffffff44 : #ffffff33;
                    animate background { duration: 140ms; easing: ease-out; }
                    Image {
                        source: is-playing ? @image-url("icons/pause_fill.svg") : @image-url("icons/play_fill.svg");
                        width: 24px;
                        height: 24px;
                        colorize: #ffffff;
                        x: 16px;
                        y: 16px;
                    }
                    pta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-play-pause(); }
                    }
                }
                IconBtn {
                    width: 40px;
                    height: 40px;
                    icon: @image-url("icons/next_fill.svg");
                    icon-size: 20px;
                    icon-color: #ffffffcc;
                    clicked => { root.play-next(); }
                }
                IconBtn {
                    width: 40px;
                    height: 40px;
                    icon: repeat-mode == 2 ? @image-url("icons/repeat_one.svg") : @image-url("icons/repeat.svg");
                    icon-size: 18px;
                    icon-color: repeat-mode > 0 ? Theme.primary : #8e9099;
                    clicked => { root.cycle-repeat(); }
                }
            }
        }

        // Right side: Synced Lyrics (.tv-karaoke-content)
        if show-lyrics-col: Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            clip: true;

            tvk-scroll := ScrollView {
                width: 100%;
                height: 100%;
                property <length> step-h: (54px + tvk-gap * 1px);
                property <length> base-target: max(0px, active-lyric-index * step-h);
                property <length> focus-offset: lyrics-focus-pos == "top"
                    ? self.visible-height * 0.28
                    : (lyrics-focus-pos == "bottom" ? -self.visible-height * 0.28 : 0px);
                content-y: (lyrics-autoscroll && active-lyric-index >= 0)
                    ? -min(max(0px, base-target + focus-offset), max(0px, self.content-height - self.visible-height))
                    : 0px;
                animate content-y { duration: Theme.reduced-motion ? 0ms : 420ms / max(0.5, lyrics-speed); easing: cubic-bezier(0.2, 0, 0, 1); }

                VerticalLayout {
                    padding-top: max(120px, tvk-scroll.visible-height * 0.42);
                    padding-bottom: max(220px, tvk-scroll.visible-height * 0.48);
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: tvk-gap * 1px;

                    for line in lyrics-lines: Rectangle {
                        border-radius: 14px;
                        background: lta.has-hover ? #ffffff14 : transparent;
                        animate background { duration: 150ms; easing: ease-out; }

                        HorizontalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;

                            if line.is_gap: Image {
                                source: @image-url("icons/music_note.svg");
                                width: 28px;
                                height: 28px;
                                colorize: line.is_active ? #ffffff : #ffffff66;
                            }

                            // Line mode OR gap line
                            if line.is_gap || lyrics-mode != "Word" || line.rows.length == 0: Text {
                                horizontal-stretch: 1;
                                text: line.is_gap ? "•••" : line.text;
                                color: line.is_active ? #ffffff : (line.is_past ? #ffffff66 : #ffffff55);
                                font-size: (line.is_active ? 34px : 28px) * (tvk-size-pct / 100.0);
                                font-weight: tvk-weight;
                                horizontal-alignment: tvk-align == 0 ? left : (tvk-align == 2 ? right : center);
                                wrap: word-wrap;
                                animate color { duration: Theme.reduced-motion ? 0ms : 220ms; easing: ease-out; }
                                animate font-size { duration: Theme.reduced-motion ? 0ms : 240ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                            }

                            // Word-by-word karaoke mode (Gradient sweep or Words highlight)
                            if !line.is_gap && lyrics-mode == "Word" && line.rows.length > 0: VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                                for row in line.rows: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: tvk-align == 0 ? start : (tvk-align == 2 ? end : center);

                                    for w in row.words: Rectangle {
                                        width: tvk-w-base.preferred-width;
                                        height: tvk-w-base.preferred-height;

                                        tvk-w-base := Text {
                                            text: w.text;
                                            color: line.is_active
                                                ? (lyrics-word-style == "words"
                                                    ? (w.is_past ? #ffffff : (w.is_active ? Theme.primary : #ffffff55))
                                                    : #ffffff55)
                                                : (line.is_past ? #ffffff66 : #ffffff44);
                                            font-size: (line.is_active ? 34px : 28px) * (tvk-size-pct / 100.0);
                                            font-weight: tvk-weight;
                                            y: (line.is_active && lyrics-word-style == "words" && w.is_active) ? -3px : 0px;
                                            animate y { duration: Theme.reduced-motion ? 0ms : 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                            animate color { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }
                                            animate font-size { duration: Theme.reduced-motion ? 0ms : 240ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                        }

                                        if line.is_active && lyrics-word-style != "words": Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width * clamp(w.progress, 0.0, 1.0);
                                            height: parent.height;
                                            clip: true;

                                            Text {
                                                x: 0px;
                                                y: 0px;
                                                width: tvk-w-base.width;
                                                height: tvk-w-base.height;
                                                text: w.text;
                                                color: #ffffff;
                                                font-size: 34px * (tvk-size-pct / 100.0);
                                                font-weight: tvk-weight;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        lta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.seek-to(line.time_sec); }
                        }
                    }
                }
            }
        }

        if !show-lyrics-col: Rectangle { horizontal-stretch: 1; }
    }

    // Top-right floating glass action buttons (.tv-karaoke-close)
    HorizontalLayout {
        x: parent.width - 288px;
        y: 24px;
        width: 260px;
        height: 44px;
        spacing: 10px;

        // Edit lyrics
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: b-edit.has-hover ? #ffffff4d : #ffffff26;
            border-width: 1px;
            border-color: #ffffff33;
            animate background { duration: 160ms; easing: ease-out; }
            Image { source: @image-url("icons/ms_edit.svg"); width: 20px; height: 20px; colorize: #ffffff; x: 12px; y: 12px; }
            b-edit := TouchArea { mouse-cursor: pointer; clicked => { root.edit-lyrics(); } }
        }

        // Sync lyrics
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: b-sync.has-hover ? #ffffff4d : #ffffff26;
            border-width: 1px;
            border-color: #ffffff33;
            animate background { duration: 160ms; easing: ease-out; }
            Image { source: @image-url("icons/clock.svg"); width: 20px; height: 20px; colorize: #ffffff; x: 12px; y: 12px; }
            b-sync := TouchArea { mouse-cursor: pointer; clicked => { root.sync-lyrics(); } }
        }

        // Customize lyrics (#btn-tvk-settings)
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: settings-panel-open ? Theme.primary : (b-set.has-hover ? #ffffff4d : #ffffff26);
            border-width: 1px;
            border-color: #ffffff33;
            animate background { duration: 160ms; easing: ease-out; }
            Image { source: @image-url("icons/ms_settings.svg"); width: 20px; height: 20px; colorize: settings-panel-open ? Theme.on-primary : #ffffff; x: 12px; y: 12px; }
            b-set := TouchArea { mouse-cursor: pointer; clicked => { settings-panel-open = !settings-panel-open; } }
        }

        // Toggle album cover mode (#btn-tvk-cover-mode)
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: cover-only-mode ? Theme.primary : (b-cov.has-hover ? #ffffff4d : #ffffff26);
            border-width: 1px;
            border-color: #ffffff33;
            animate background { duration: 160ms; easing: ease-out; }
            Image { source: @image-url("icons/ms_album.svg"); width: 20px; height: 20px; colorize: cover-only-mode ? Theme.on-primary : #ffffff; x: 12px; y: 12px; }
            b-cov := TouchArea { mouse-cursor: pointer; clicked => { cover-only-mode = !cover-only-mode; } }
        }

        // Close (#btn-close-tv-karaoke)
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: b-cls.has-hover ? #ffffff4d : #ffffff26;
            border-width: 1px;
            border-color: #ffffff33;
            animate background { duration: 160ms; easing: ease-out; }
            Image { source: @image-url("icons/chev_down.svg"); width: 22px; height: 22px; colorize: #ffffff; x: 11px; y: 11px; }
            b-cls := TouchArea { mouse-cursor: pointer; clicked => { settings-panel-open = false; root.close(); } }
        }
    }

    // Top-center Customize Lyrics drop-down panel (.tvk-panel)
    Rectangle {
        width: min(420px, parent.width - 32px);
        height: 490px;
        x: (parent.width - self.width) / 2;
        y: settings-panel-open ? 0px : -510px;
        opacity: settings-panel-open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        border-bottom-left-radius: 28px;
        border-bottom-right-radius: 28px;
        background: #222328eb;
        backdrop-blur: 24px;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000073;
        animate y { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 200ms; easing: ease-out; }

        TouchArea {}

        VerticalLayout {
            padding: 20px;
            spacing: 10px;

            // Mode & Word Style
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Mode"; color: #ffffff; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                PillBtn {
                    label: "Word";
                    btn-height: 28px;
                    primary: lyrics-mode == "Word";
                    clicked => { lyrics-mode = "Word"; root.save-setting("slint_lyrics_mode", "Word"); }
                }
                PillBtn {
                    label: "Line";
                    btn-height: 28px;
                    primary: lyrics-mode == "Line";
                    clicked => { lyrics-mode = "Line"; root.save-setting("slint_lyrics_mode", "Line"); }
                }
                PillBtn {
                    label: lyrics-word-style == "gradient" ? "Gradient" : "Words";
                    btn-height: 28px;
                    clicked => {
                        lyrics-word-style = lyrics-word-style == "gradient" ? "words" : "gradient";
                        root.save-setting("slint_lyrics_word_style", lyrics-word-style);
                    }
                }
            }

            // Lyrics Source
            VerticalLayout {
                spacing: 4px;
                Text { text: "Lyrics source (" + lyrics-source-label + ")"; color: #ffffff; font-size: 13px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 4px;
                    for src in [
                        { id: "auto", label: "Auto" },
                        { id: "lrclib", label: "LRCLIB" },
                        { id: "musixmatch", label: "Musixmatch" },
                        { id: "kugou", label: "Kugou" },
                        { id: "netease", label: "NetEase" },
                        { id: "genius", label: "Genius" },
                    ]: PillBtn {
                        label: src.label;
                        btn-height: 26px;
                        h-pad: 8px;
                        primary: lyrics-source == src.id;
                        clicked => {
                            lyrics-source = src.id;
                            root.change-lyrics-source(src.id);
                        }
                    }
                }
            }

            // Sync Offset
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Sync offset: " + (lyrics-offset-ms >= 0 ? "+" : "") + Math.round(lyrics-offset-ms) + "ms"; color: #ffffff; font-size: 12.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                PillBtn { label: "-250ms"; btn-height: 24px; h-pad: 8px; clicked => { lyrics-offset-ms = clamp(lyrics-offset-ms - 250.0, -5000.0, 5000.0); root.set-lyrics-offset(lyrics-offset-ms); } }
                PillBtn { label: "0"; btn-height: 24px; h-pad: 8px; clicked => { lyrics-offset-ms = 0.0; root.set-lyrics-offset(0.0); } }
                PillBtn { label: "+250ms"; btn-height: 24px; h-pad: 8px; clicked => { lyrics-offset-ms = clamp(lyrics-offset-ms + 250.0, -5000.0, 5000.0); root.set-lyrics-offset(lyrics-offset-ms); } }
            }

            // Alignment
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Alignment"; color: #ffffff; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                for al in [
                    { idx: 0, icon: @image-url("icons/align_left.svg") },
                    { idx: 1, icon: @image-url("icons/align_center.svg") },
                    { idx: 2, icon: @image-url("icons/align_right.svg") },
                ]: Rectangle {
                    width: 36px;
                    height: 30px;
                    border-radius: 10px;
                    background: tvk-align == al.idx ? Theme.primary : #ffffff18;
                    Image { source: al.icon; width: 16px; height: 16px; colorize: tvk-align == al.idx ? Theme.on-primary : #ffffff; x: 10px; y: 7px; }
                    TouchArea { mouse-cursor: pointer; clicked => { tvk-align = al.idx; } }
                }
            }

            // Size
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    Text { text: "Size"; color: #ffffff; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: Math.round(tvk-size-pct) + "%"; color: Theme.primary; font-size: 12.5px; font-weight: 600; }
                }
                Slider { height: 24px; minimum: 60.0; maximum: 160.0; value <=> tvk-size-pct; }
            }

            // Line spacing
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    Text { text: "Line spacing"; color: #ffffff; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: Math.round(tvk-gap) + "px"; color: Theme.primary; font-size: 12.5px; font-weight: 600; }
                }
                Slider { height: 24px; minimum: 4.0; maximum: 40.0; value <=> tvk-gap; }
            }

            // Visualizer toggles
            HorizontalLayout {
                Text { text: "No-lyrics visualizer"; color: #ffffff; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                ToggleSwitch { checked <=> tvk-vis-nolyrics; }
            }
            HorizontalLayout {
                Text { text: "Visualizer with lyrics"; color: #ffffff; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                ToggleSwitch { checked <=> tvk-vis-lyrics; }
            }

            // Visualizer opacity
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    Text { text: "Visualizer opacity"; color: #ffffff; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                    Text { text: Math.round(tvk-vis-opacity * 100) + "%"; color: Theme.primary; font-size: 12.5px; font-weight: 600; }
                }
                Slider { height: 24px; minimum: 0.1; maximum: 1.0; value <=> tvk-vis-opacity; }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillBtn {
                    label: "Reset";
                    clicked => {
                        tvk-align = 1;
                        tvk-size-pct = 100.0;
                        tvk-weight = 700;
                        tvk-gap = 16.0;
                        tvk-vis-nolyrics = true;
                        tvk-vis-lyrics = true;
                        tvk-vis-opacity = 0.85;
                    }
                }
                PillBtn {
                    label: "Done";
                    primary: true;
                    clicked => { settings-panel-open = false; }
                }
            }
        }
    }
}

// ============================================================================
// CUSTOM LYRICS EDITOR MODAL (#custom-lyrics-modal 1:1)
// ============================================================================
export component CustomLyricsModal inherits Rectangle {
    in property <bool> open: false;
    in property <string> track-title: "No track selected";
    in property <string> track-artist: "";
    in-out property <string> lyrics-text: "";
    callback save(string);
    callback close();

    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #00000085;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(520px, parent.width - 40px);
        height: min(540px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 28px;
        border-radius: 24px;
        background: #1c1d22e6;
        backdrop-blur: Theme.ambient-blur-enabled ? 24px : 0px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: #00000099;
        animate y { duration: Theme.reduced-motion ? 0ms : 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        TouchArea {}

        VerticalLayout {
            padding: 22px;
            spacing: 12px;

            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/ms_edit.svg"); width: 20px; height: 20px; colorize: Theme.primary; }
                }
                Text { text: "Custom lyrics editor"; color: Theme.text-primary; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                IconBtn { width: 32px; height: 32px; icon: @image-url("icons/ms_close.svg"); icon-size: 16px; clicked => { root.close(); } }
            }

            Text { text: "Paste or type lyrics for the current track. One line per row."; color: Theme.text-secondary; font-size: 13px; }

            Rectangle {
                border-radius: 12px;
                background: #25262c;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: track-title; color: Theme.text-primary; font-size: 13.5px; font-weight: 700; overflow: elide; }
                    Text { text: track-artist != "" ? "• " + track-artist : ""; color: Theme.text-muted; font-size: 13px; overflow: elide; }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: #9f99e61a;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text { text: "Tip: Type [Instrumental] on a new line to display the music visualizer icon during breaks."; color: Theme.primary; font-size: 12px; wrap: word-wrap; }
                }
            }

            TextEdit {
                vertical-stretch: 1;
                text <=> lyrics-text;
                font-size: 13.5px;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                PillBtn { label: "Cancel"; clicked => { root.close(); } }
                PillBtn { label: "Save lyrics"; primary: true; clicked => { root.save(lyrics-text); } }
            }
        }
    }
}

// ============================================================================
// TAP-TO-SYNC LYRICS MODAL (#sync-mode-overlay 1:1)
// ============================================================================
export component SyncLyricsModal inherits Rectangle {
    in property <bool> open: false;
    in property <string> track-title: "";
    in property <string> track-artist: "";
    in property <bool> is-playing: false;
    in property <[SyncLineData]> lines: [];
    in property <int> synced-count: 0;
    callback tap-line(int);
    callback toggle-play-pause();
    callback restart();
    callback save-and-exit();
    callback close();

    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #00000085;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(520px, parent.width - 40px);
        height: min(580px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 28px;
        border-radius: 24px;
        background: #1c1d22e6;
        backdrop-blur: Theme.ambient-blur-enabled ? 24px : 0px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: #00000099;
        animate y { duration: Theme.reduced-motion ? 0ms : 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        TouchArea {}

        VerticalLayout {
            padding: 22px;
            spacing: 12px;

            // Header: Recording dot + badge + counter + close
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f28b82; }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 22px;
                        border-radius: 11px;
                        background: #2a2b32;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { text: "Recording"; color: #f28b82; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                }
                Text {
                    text: synced-count + " / " + lines.length + " lines synced";
                    color: Theme.text-secondary;
                    font-size: 12.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconBtn { width: 32px; height: 32px; icon: @image-url("icons/ms_close.svg"); icon-size: 16px; clicked => { root.close(); } }
            }

            // Tip banner
            Rectangle {
                border-radius: 12px;
                background: #25262c;
                HorizontalLayout {
                    padding: 10px;
                    alignment: center;
                    Text { text: "Tap a line or press Space on beat (" + track-title + ")"; color: Theme.text-muted; font-size: 12px; overflow: elide; }
                }
            }

            // Controls bar
            HorizontalLayout {
                spacing: 8px;
                PillBtn { label: is-playing ? "Pause" : "Play"; clicked => { root.toggle-play-pause(); } }
                PillBtn { label: "Restart"; clicked => { root.restart(); } }
                Rectangle { horizontal-stretch: 1; }
                PillBtn { label: "Save and exit"; primary: true; clicked => { root.save-and-exit(); } }
            }

            // Lines list
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    padding-top: 4px;
                    padding-bottom: 16px;

                    for line[idx] in lines: Rectangle {
                        border-radius: 10px;
                        background: line.is_next ? Theme.primary-dim : (sta.has-hover ? #26272e : transparent);
                        animate background { duration: 120ms; easing: ease-out; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 10px;

                            Text {
                                horizontal-stretch: 1;
                                text: line.is_gap ? "[Instrumental]" : line.text;
                                color: line.is_next ? Theme.text-primary : (line.is_synced ? Theme.text-muted : #e2e2e999);
                                font-size: 14px;
                                font-weight: line.is_next ? 700 : 500;
                                wrap: word-wrap;
                            }

                            if line.is_synced: Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: #2c2d35;
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    Text { text: line.time_str; color: Theme.primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                }
                            }
                        }

                        sta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tap-line(idx); }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// AUDIO EDITOR MODAL (#audio-settings-modal 1:1)
// ============================================================================
export component AudioEditorModal inherits Rectangle {
    in property <bool> open: false;
    in-out property <int> tab: 3; // 0: Enhancer, 1: Speed & Pitch, 2: Audio FX, 3: Equalizer, 4: Sleep
    in-out property <bool> clear-sound: false;
    in-out property <float> speed: 1.0;
    in-out property <float> reverb: 0.0;
    in-out property <float> distortion: 0.0;
    in-out property <float> eq-bass: 0.0;
    in-out property <float> eq-mid: 0.0;
    in-out property <float> eq-treble: 0.0;
    in-out property <string> eq-preset-name: "Default";
    in property <string> sleep-status: "00:00";
    in property <bool> sleep-active: false;

    callback set-speed(float);
    callback set-effects(float, float);
    callback set-eq(float, float, float);
    callback apply-preset(string);
    callback set-sleep-minutes(int); // -1: track end, 0: off, >0: minutes
    callback add-sleep-5m();
    callback reset-audio();
    callback close();

    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #00000085;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(660px, parent.width - 40px);
        height: min(540px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 28px;
        border-radius: 24px;
        background: #1c1d22e6;
        backdrop-blur: Theme.ambient-blur-enabled ? 24px : 0px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: #00000099;
        animate y { duration: Theme.reduced-motion ? 0ms : 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        TouchArea {}

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            // Header
            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/ms_tune.svg"); width: 20px; height: 20px; colorize: Theme.primary; }
                }
                Text { text: "Audio"; color: Theme.text-primary; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                PillBtn { label: "Reset"; btn-height: 30px; clicked => { root.reset-audio(); } }
                IconBtn { width: 32px; height: 32px; icon: @image-url("icons/ms_close.svg"); icon-size: 16px; clicked => { root.close(); } }
            }

            // Tabs bar
            HorizontalLayout {
                spacing: 6px;
                height: 38px;
                for t in [
                    { idx: 0, label: "Enhancer" },
                    { idx: 1, label: "Speed & Pitch" },
                    { idx: 2, label: "Audio FX" },
                    { idx: 3, label: "Equalizer" },
                    { idx: 4, label: "Sleep" },
                ]: Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border-radius: 12px;
                    background: tab == t.idx ? Theme.primary : (tta.has-hover ? #2a2b32 : #23242a);
                    animate background { duration: 140ms; easing: ease-out; }
                    Text {
                        text: t.label;
                        color: tab == t.idx ? Theme.on-primary : Theme.text-secondary;
                        font-size: 12.5px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tta := TouchArea { mouse-cursor: pointer; clicked => { tab = t.idx; } }
                }
            }

            // Tab content
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;

                    // 0: Enhancer
                    if tab == 0: VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            border-radius: 16px;
                            background: #24252c;
                            HorizontalLayout {
                                padding: 16px;
                                Text { text: "Clear sound"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                ToggleSwitch {
                                    checked <=> clear-sound;
                                    toggled(on) => {
                                        if (on) {
                                            eq-bass = 2.0; eq-mid = 2.5; eq-treble = 3.5;
                                            root.set-eq(2.0, 2.5, 3.5);
                                        } else {
                                            eq-bass = 0.0; eq-mid = 0.0; eq-treble = 0.0;
                                            root.set-eq(0.0, 0.0, 0.0);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            border-radius: 16px;
                            background: #24252c;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                Text { text: "Vocals (Mid): " + Math.round(eq-mid) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                Slider { height: 32px; minimum: -12.0; maximum: 12.0; value <=> eq-mid; changed(v) => { root.set-eq(eq-bass, v, eq-treble); } }
                                Text { text: "Treble (Air): " + Math.round(eq-treble) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                Slider { height: 32px; minimum: -12.0; maximum: 12.0; value <=> eq-treble; changed(v) => { root.set-eq(eq-bass, eq-mid, v); } }
                                Text { text: "Bass: " + Math.round(eq-bass) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                Slider { height: 32px; minimum: -12.0; maximum: 12.0; value <=> eq-bass; changed(v) => { root.set-eq(v, eq-mid, eq-treble); } }
                            }
                        }
                    }

                    // 1: Speed & Pitch
                    if tab == 1: VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            border-radius: 16px;
                            background: #24252c;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;
                                HorizontalLayout {
                                    Text { text: "Playback Speed"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; }
                                    Text { text: Math.round(speed * 100) / 100 + "x"; color: Theme.primary; font-size: 14px; font-weight: 700; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for sp in [0.8, 0.9, 1.0, 1.15, 1.25, 1.35, 1.5]: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        border-radius: 10px;
                                        background: Math.abs(speed - sp) < 0.02 ? Theme.primary : #2e3038;
                                        Text {
                                            text: "x" + sp;
                                            color: Math.abs(speed - sp) < 0.02 ? Theme.on-primary : Theme.text-primary;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { speed = sp; root.set-speed(sp); }
                                        }
                                    }
                                }
                                Slider {
                                    height: 32px;
                                    minimum: 0.5;
                                    maximum: 2.0;
                                    value <=> speed;
                                    changed(v) => { root.set-speed(v); }
                                }
                            }
                        }
                    }

                    // 2: Audio FX
                    if tab == 2: VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            border-radius: 16px;
                            background: #24252c;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                HorizontalLayout {
                                    Text { text: "Reverb"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; }
                                    Text { text: Math.round(reverb) + "%"; color: Theme.primary; font-size: 13.5px; font-weight: 700; }
                                }
                                Slider { height: 32px; minimum: 0.0; maximum: 100.0; value <=> reverb; changed(v) => { root.set-effects(v, distortion); } }

                                HorizontalLayout {
                                    Text { text: "Distortion"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; horizontal-stretch: 1; }
                                    Text { text: Math.round(distortion) + "%"; color: Theme.primary; font-size: 13.5px; font-weight: 700; }
                                }
                                Slider { height: 32px; minimum: 0.0; maximum: 100.0; value <=> distortion; changed(v) => { root.set-effects(reverb, v); } }
                            }
                        }
                    }

                    // 3: Equalizer
                    if tab == 3: VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            border-radius: 16px;
                            background: #24252c;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text { text: "3-Band Equalizer"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; }
                                Text { text: "Bass (100Hz): " + Math.round(eq-bass) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                Slider { height: 32px; minimum: -12.0; maximum: 12.0; value <=> eq-bass; changed(v) => { root.set-eq(v, eq-mid, eq-treble); } }
                                Text { text: "Mid (1kHz): " + Math.round(eq-mid) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                Slider { height: 32px; minimum: -12.0; maximum: 12.0; value <=> eq-mid; changed(v) => { root.set-eq(eq-bass, v, eq-treble); } }
                                Text { text: "Treble (10kHz): " + Math.round(eq-treble) + " dB"; color: Theme.text-secondary; font-size: 13px; }
                                Slider { height: 32px; minimum: -12.0; maximum: 12.0; value <=> eq-treble; changed(v) => { root.set-eq(eq-bass, eq-mid, v); } }
                            }
                        }
                    }

                    // 4: Sleep Timer
                    if tab == 4: VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            border-radius: 20px;
                            background: #24252c;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 16px;

                                Text {
                                    text: sleep-status;
                                    color: sleep-active ? Theme.primary : Theme.text-primary;
                                    font-size: 36px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    for mins in [15, 30, 45, 60, 90]: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 48px;
                                        border-radius: 14px;
                                        background: #2e3038;
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: mins + ""; color: Theme.text-primary; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: "min"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: center; }
                                        }
                                        TouchArea { mouse-cursor: pointer; clicked => { root.set-sleep-minutes(mins); } }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    PillBtn { label: "End of track"; clicked => { root.set-sleep-minutes(-1); } }
                                    PillBtn { label: "+5m"; clicked => { root.add-sleep-5m(); } }
                                    PillBtn { label: "Turn off"; clicked => { root.set-sleep-minutes(0); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// CREATE PLAYLIST & ADD TO PLAYLIST MODALS
// ============================================================================
export component CreatePlaylistModal inherits Rectangle {
    in property <bool> open: false;
    in-out property <string> playlist-name: "";
    callback create(string);
    callback close();

    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #00000085;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(400px, parent.width - 40px);
        height: 190px;
        x: (parent.width - self.width) / 2;
        y: open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 24px;
        border-radius: 24px;
        background: #1c1d22e6;
        backdrop-blur: Theme.ambient-blur-enabled ? 24px : 0px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000099;
        animate y { duration: Theme.reduced-motion ? 0ms : 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        TouchArea {}

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            Text { text: "Create playlist"; color: Theme.text-primary; font-size: 18px; font-weight: 700; }

            LineEdit {
                text <=> playlist-name;
                placeholder-text: "My playlist";
                accepted => {
                    if (playlist-name != "") {
                        root.create(playlist-name);
                        playlist-name = "";
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                PillBtn { label: "Cancel"; clicked => { root.close(); } }
                PillBtn {
                    label: "Create";
                    primary: true;
                    clicked => {
                        if (playlist-name != "") {
                            root.create(playlist-name);
                            playlist-name = "";
                        }
                    }
                }
            }
        }
    }
}

export component AddToPlaylistModal inherits Rectangle {
    in property <bool> open: false;
    in property <string> track-title: "";
    in property <[PlaylistData]> playlists: [];
    callback select-playlist(string);
    callback create-new();
    callback close();

    opacity: open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: #00000085;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }

    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(400px, parent.width - 40px);
        height: min(420px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 24px;
        border-radius: 24px;
        background: #1c1d22e6;
        backdrop-blur: Theme.ambient-blur-enabled ? 24px : 0px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000099;
        animate y { duration: Theme.reduced-motion ? 0ms : 260ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        TouchArea {}

        VerticalLayout {
            padding: 22px;
            spacing: 12px;

            HorizontalLayout {
                Text { text: "Add to playlist"; color: Theme.text-primary; font-size: 18px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                IconBtn { width: 32px; height: 32px; icon: @image-url("icons/ms_close.svg"); icon-size: 16px; clicked => { root.close(); } }
            }

            Text { text: track-title; color: Theme.text-muted; font-size: 13px; overflow: elide; }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    if playlists.length == 0: Text {
                        text: "No playlists yet. Create one below!";
                        color: Theme.text-muted;
                        font-size: 13.5px;
                        horizontal-alignment: center;
                    }
                    for pl in playlists: Rectangle {
                        height: 48px;
                        border-radius: 12px;
                        background: pta.has-hover ? #2a2b34 : #23242b;
                        animate background { duration: 140ms; easing: ease-out; }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/ms_queue_music.svg"); width: 18px; height: 18px; colorize: Theme.primary; }
                            }
                            Text { text: pl.name; color: Theme.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: pl.track_count + " tracks"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                        }
                        pta := TouchArea { mouse-cursor: pointer; clicked => { root.select-playlist(pl.id); } }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                PillBtn { label: "New playlist"; primary: true; clicked => { root.create-new(); } }
            }
        }
    }
}
