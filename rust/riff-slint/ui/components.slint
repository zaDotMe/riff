import { Theme, TrackData, RemotePlaylistData, ArtistData } from "theme.slint";

export component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <color> icon-color: Theme.text-secondary;
    in property <color> active-bg: Theme.primary;
    in property <color> active-icon-color: Theme.on-primary;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <color> base-bg: transparent;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: (ta.has-hover && !disabled) ? self.width * 0.38 : self.width / 2;
    background: active ? active-bg : (ta.has-hover && !disabled ? Theme.surface-hover : base-bg);
    opacity: disabled ? 0.28 : (ta.pressed ? 0.78 : 1.0);
    animate background { duration: Theme.reduced-motion ? 0ms : 150ms; easing: ease-out; }
    animate border-radius { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    animate opacity { duration: Theme.reduced-motion ? 0ms : 110ms; easing: ease-out; }

    Image {
        source: icon;
        width: ta.pressed && !disabled ? icon-size * 0.9 : icon-size;
        height: ta.pressed && !disabled ? icon-size * 0.9 : icon-size;
        colorize: active ? active-icon-color : (ta.has-hover && !disabled ? Theme.text-primary : icon-color);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        animate colorize { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }
        animate width { duration: Theme.reduced-motion ? 0ms : 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate height { duration: Theme.reduced-motion ? 0ms : 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    }

    ta := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// Window control button with a staggered reveal animation when the
// auto-hide titlebar slides down from the top edge.
export component WinBtn inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 14px;
    in property <color> hover-bg: #2a2a30;
    in property <color> icon-color: Theme.text-secondary;
    in property <color> hover-icon-color: Theme.text-primary;
    in property <bool> active: false;
    in property <color> active-icon-color: Theme.primary;
    in property <bool> revealed: true;
    in property <duration> reveal-delay: 0ms;
    out property <bool> hovered: ta.has-hover;
    callback clicked();

    width: 34px;
    height: 28px;
    y: 6px;
    border-radius: ta.has-hover ? 11px : 14px;
    background: ta.has-hover ? hover-bg : transparent;
    opacity: shown ? 1.0 : 0.0;
    animate background { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }
    animate border-radius { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate opacity { duration: Theme.reduced-motion ? 0ms : 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    property <bool> shown: false;

    // Delay each control slightly so the buttons cascade in after the bar.
    Timer {
        interval: Theme.reduced-motion ? 0ms : reveal-delay;
        running: revealed && !shown;
        triggered => { shown = true; }
    }

    // Keep the controls visible while the bar slides away, then reset for the
    // next reveal so the entrance animation can play again.
    Timer {
        interval: Theme.reduced-motion ? 0ms : 300ms;
        running: !revealed && shown;
        triggered => { shown = false; }
    }

    Image {
        source: icon;
        width: ta.pressed ? icon-size * 0.9 : (ta.has-hover ? icon-size + 1px : icon-size);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (shown ? 0px : 3px);
        colorize: active ? active-icon-color : (ta.has-hover ? hover-icon-color : icon-color);
        animate width { duration: Theme.reduced-motion ? 0ms : 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate height { duration: Theme.reduced-motion ? 0ms : 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate y { duration: Theme.reduced-motion ? 0ms : 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate colorize { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: shown;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PillBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <length> btn-height: 34px;
    in property <length> h-pad: 12px;
    in property <length> radius: 10px;
    callback clicked();

    height: btn-height;
    border-radius: ta.has-hover ? min(radius + 4px, btn-height / 2) : radius;
    background: primary
        ? (ta.has-hover ? Theme.primary.brighter(0.12) : Theme.primary)
        : (ta.has-hover ? #2e2e36 : #232328);
    opacity: ta.pressed ? 0.84 : 1.0;
    animate background { duration: Theme.reduced-motion ? 0ms : 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate border-radius { duration: Theme.reduced-motion ? 0ms : 200ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    animate opacity { duration: Theme.reduced-motion ? 0ms : 100ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: h-pad;
        padding-right: h-pad;
        spacing: 6px;
        alignment: center;

        if has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: icon;
                width: 16px;
                height: 16px;
                colorize: primary ? Theme.on-primary : Theme.text-primary;
            }
        }

        Text {
            text: label;
            color: primary ? Theme.on-primary : Theme.text-primary;
            font-size: 12.5px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.primary : #1c1c20;
    border-width: checked ? 0px : 2px;
    border-color: Theme.text-muted;
    animate background { duration: 160ms; easing: ease-out; }

    Rectangle {
        width: checked ? 24px : 16px;
        height: checked ? 24px : 16px;
        border-radius: self.width / 2;
        background: checked ? Theme.on-primary : Theme.text-muted;
        x: checked ? parent.width - self.width - 4px : 6px;
        y: (parent.height - self.height) / 2;
        animate x { duration: 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate width { duration: 140ms; easing: ease-out; }
        animate height { duration: 140ms; easing: ease-out; }
        animate background { duration: 140ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            checked = !checked;
            root.toggled(checked);
        }
    }
}

export component HomeCard inherits Rectangle {
    in property <TrackData> track;
    in property <string> override-title: "";
    in property <string> override-sub: "";
    callback clicked();

    width: 180px;
    height: 236px;
    background: transparent;

    VerticalLayout {
        padding: 0px;
        spacing: 8px;

        Rectangle {
            width: 180px;
            height: 184px;
            background: transparent;

            Rectangle {
                width: 180px;
                height: 180px;
                y: ta.has-hover ? 0px : 4px;
                border-radius: 14px;
                background: #1e1f22;
                clip: true;
                animate y { duration: Theme.reduced-motion ? 0ms : 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                if track.has_cover: Image {
                    source: track.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }

                if !track.has_cover: Image {
                    source: @image-url("icons/play_circle.svg");
                    width: 36px;
                    height: 36px;
                    colorize: Theme.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                // Subtle hover scrim
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: ta.has-hover ? #00000024 : transparent;
                    animate background { duration: 160ms; easing: ease-out; }
                }

                Rectangle {
                    width: ta.has-hover ? 44px : 32px;
                    height: ta.has-hover ? 44px : 32px;
                    border-radius: self.width / 2;
                    background: Theme.primary;
                    x: parent.width - self.width - 10px;
                    y: ta.has-hover ? parent.height - self.height - 10px : parent.height - self.height + 4px;
                    opacity: ta.has-hover ? 1.0 : 0.0;
                    drop-shadow-blur: 16px;
                    drop-shadow-offset-y: 4px;
                    drop-shadow-color: #00000080;
                    animate opacity { duration: Theme.reduced-motion ? 0ms : 180ms; easing: ease-out; }
                    animate y { duration: Theme.reduced-motion ? 0ms : 240ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    animate width { duration: Theme.reduced-motion ? 0ms : 240ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    animate height { duration: Theme.reduced-motion ? 0ms : 240ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

                    Image {
                        source: @image-url("icons/play_fill.svg");
                        width: 18px;
                        height: 18px;
                        colorize: Theme.on-primary;
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            padding-left: 2px;
            padding-right: 2px;

            Text {
                text: override-title != "" ? override-title : track.title;
                color: Theme.text-primary;
                font-size: 14.5px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: override-sub != "" ? override-sub : track.artist;
                color: Theme.text-secondary;
                font-size: 12.5px;
                font-weight: 400;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TrackRow inherits Rectangle {
    in property <int> index;
    in property <TrackData> track;
    in property <bool> is-current: false;
    in property <bool> is-playing: false;
    in property <bool> is-buffering: false;
    in property <bool> show-album: true;
    in property <bool> show-queue-btn: true;
    in property <bool> show-remove: false;
    callback play-clicked();
    callback toggle-favorite();
    callback add-to-playlist();
    callback add-to-queue();
    callback remove-clicked();
    callback artist-clicked(string);

    property <float> eq-t: (is-current && is-playing && !Theme.reduced-motion) ? (animation-tick() / 1s) : 0.0;
    property <bool> q-hovered: false;
    property <bool> rm-hovered: false;
    property <bool> row-hovered: ta.has-hover || fav-ta.has-hover || add-ta.has-hover || q-hovered || rm-hovered || art-ta.has-hover;

    height: 64px;
    border-radius: 8px;
    background: is-current ? Theme.surface-active : (row-hovered ? #ffffff0f : transparent);
    animate background { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.play-clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // # or animated playing EQ bars (spBarEq)
        Rectangle {
            width: 24px;
            height: 100%;

            if is-current && is-playing && !ta.has-hover: HorizontalLayout {
                width: 16px;
                height: 14px;
                x: 4px;
                y: (parent.height - self.height) / 2;
                spacing: 2px;
                alignment: center;

                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 3px;
                        height: 4px + 10px * (0.5 + 0.5 * Math.sin(eq-t * 7.5rad));
                        border-radius: 1.5px;
                        background: Theme.primary;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 3px;
                        height: 4px + 10px * (0.5 + 0.5 * Math.sin(eq-t * 9.2rad + 1.8rad));
                        border-radius: 1.5px;
                        background: Theme.primary;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 3px;
                        height: 4px + 10px * (0.5 + 0.5 * Math.sin(eq-t * 6.4rad + 3.4rad));
                        border-radius: 1.5px;
                        background: Theme.primary;
                    }
                }
            }

            if !(is-current && is-playing && !ta.has-hover): Text {
                width: 100%;
                height: 100%;
                text: (is-current || ta.has-hover) ? "▶" : (index + 1);
                color: is-current ? Theme.primary : (ta.has-hover ? Theme.text-primary : Theme.text-muted);
                font-size: 13px;
                font-weight: is-current ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Cover 46x46
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 6px;
                background: #1a1a1e;
                clip: true;

                if track.has_cover: Image {
                    source: track.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }

                if !track.has_cover: Image {
                    source: @image-url("icons/play_circle.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.text-muted;
                    x: 14px;
                    y: 14px;
                }
            }
        }

        // Title + Artist (fixed 0 preferred-width so stretch 2:1 aligns Album column straight!)
        VerticalLayout {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 2;
            alignment: center;
            spacing: 2px;

            Text {
                text: track.title;
                color: is-current ? Theme.primary : Theme.text-primary;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            Rectangle {
                height: 16px;
                Text {
                    width: 100%;
                    text: track.artist;
                    color: art-ta.has-hover ? Theme.primary : Theme.text-secondary;
                    font-size: 12px;
                    overflow: elide;
                }
                art-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.artist-clicked(track.artist); }
                }
            }
        }

        // Album / Platform with logo (fixed 0 preferred-width so every row aligns straight!)
        if show-album: HorizontalLayout {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
            spacing: 7px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    width: 14px;
                    height: 14px;
                    source: track.platform == "soundcloud"
                        ? @image-url("icons/soundcloud.svg")
                        : (track.platform == "youtube"
                            ? @image-url("icons/youtube.svg")
                            : (track.platform == "local"
                                ? @image-url("icons/cloud_off.svg")
                                : (track.platform == "history"
                                    ? @image-url("icons/ms_history.svg")
                                    : (track.platform == "favorite"
                                        ? @image-url("icons/heart_fill.svg")
                                        : @image-url("icons/ytmusic.svg")))));
                    colorize: track.platform == "soundcloud"
                        ? #ff7700
                        : (track.platform == "local" || track.platform == "history"
                            ? Theme.text-muted
                            : (track.platform == "favorite"
                                ? Theme.primary
                                : #ff4e45));
                }
            }

            Text {
                min-width: 0px;
                horizontal-stretch: 1;
                text: track.album != ""
                    ? track.album
                    : (track.platform == "ytmusic"
                        ? "YouTube Music"
                        : (track.platform == "youtube"
                            ? "YouTube"
                            : (track.platform == "soundcloud"
                                ? "SoundCloud"
                                : (track.platform == "local" ? "Local" : track.platform))));
                color: Theme.text-muted;
                font-size: 12.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Add to queue button (visible on hover)
        if show-queue-btn: VerticalLayout {
            width: 26px;
            alignment: center;
            opacity: row-hovered ? 1.0 : 0.0;
            animate opacity { duration: 140ms; easing: ease-out; }

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: q-ta.has-hover ? #ffffff18 : transparent;
                Image {
                    source: @image-url("icons/ms_queue_music.svg");
                    width: 15px;
                    height: 15px;
                    colorize: q-ta.has-hover ? Theme.primary : Theme.text-secondary;
                    x: 5.5px;
                    y: 5.5px;
                }
                q-ta := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => { q-hovered = self.has-hover; }
                    clicked => { root.add-to-queue(); }
                }
            }
        }

        // Add to playlist button (visible on hover)
        VerticalLayout {
            width: 26px;
            alignment: center;
            opacity: row-hovered ? 1.0 : 0.0;
            animate opacity { duration: 140ms; easing: ease-out; }

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: add-ta.has-hover ? #ffffff18 : transparent;
                Image {
                    source: @image-url("icons/ms_playlist_add.svg");
                    width: 16px;
                    height: 16px;
                    colorize: add-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    x: 5px;
                    y: 5px;
                }
                add-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.add-to-playlist(); }
                }
            }
        }

        // Fav toggle button
        VerticalLayout {
            width: 26px;
            alignment: center;
            opacity: (track.is_favorite || row-hovered) ? 1.0 : 0.0;
            animate opacity { duration: 140ms; easing: ease-out; }

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: fav-ta.has-hover ? #ffffff18 : transparent;
                Image {
                    source: track.is_favorite ? @image-url("icons/heart_fill.svg") : @image-url("icons/heart_outline.svg");
                    width: 15px;
                    height: 15px;
                    colorize: track.is_favorite ? Theme.primary : Theme.text-secondary;
                    x: 5.5px;
                    y: 5.5px;
                }
                fav-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-favorite(); }
                }
            }
        }

        // Remove button (used in Queue, Playlist detail, Local files)
        if show-remove: VerticalLayout {
            width: 26px;
            alignment: center;
            opacity: row-hovered ? 1.0 : 0.0;
            animate opacity { duration: 140ms; easing: ease-out; }

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: rm-ta.has-hover ? #f28b8228 : transparent;
                Image {
                    source: @image-url("icons/ms_close.svg");
                    width: 14px;
                    height: 14px;
                    colorize: rm-ta.has-hover ? #f28b82 : Theme.text-muted;
                    x: 6px;
                    y: 6px;
                }
                rm-ta := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => { rm-hovered = self.has-hover; }
                    clicked => { root.remove-clicked(); }
                }
            }
        }

        // Duration / Buffering badge
        Text {
            width: 44px;
            text: (is-current && is-buffering) ? "..." : track.duration_str;
            color: (is-current && is-buffering) ? Theme.primary : Theme.text-muted;
            font-size: 12.5px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component ScrubberBar inherits Rectangle {
    in property <float> value: 0.0;
    in property <float> maximum: 1.0;
    in property <bool> active: false;
    callback seeked(float);

    height: 20px;
    background: transparent;

    property <float> ratio: active && maximum > 0.0 ? clamp(value / maximum, 0.0, 1.0) : 0.0;

    Rectangle {
        height: active ? (ta.has-hover || ta.pressed ? 5px : 4px) : 3px;
        width: 100%;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: active ? #323238 : #ffffff24;
        animate height { duration: 120ms; easing: ease-out; }

        if active: Rectangle {
            width: parent.width * ratio;
            height: 100%;
            border-radius: 3px;
            background: ta.has-hover || ta.pressed ? Theme.primary : #e2e2e9;
            animate background { duration: 120ms; easing: ease-out; }
        }
    }

    if active: Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        x: clamp(parent.width * ratio - 6px, 0px, parent.width - 12px);
        y: (parent.height - self.height) / 2;
        opacity: (ta.has-hover || ta.pressed) ? 1.0 : 0.0;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000066;
        animate opacity { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: active;
        mouse-cursor: active ? pointer : default;
        clicked => {
            if (maximum > 0.0 && self.width > 0px) {
                root.seeked(clamp(self.mouse-x / self.width, 0.0, 1.0) * maximum);
            }
        }
        moved => {
            if (self.pressed && maximum > 0.0 && self.width > 0px) {
                root.seeked(clamp(self.mouse-x / self.width, 0.0, 1.0) * maximum);
            }
        }
    }
}

export component VolumeBar inherits Rectangle {
    in-out property <float> value: 1.0;
    callback changed(float);

    width: 90px;
    height: 24px;
    background: transparent;

    property <float> ratio: clamp(value, 0.0, 1.0);

    Rectangle {
        height: 4px;
        width: 100%;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: #3a3a40;

        Rectangle {
            width: parent.width * ratio;
            height: 100%;
            border-radius: 2px;
            background: ta.has-hover || ta.pressed ? Theme.primary : #ebebef;
            animate background { duration: 120ms; easing: ease-out; }
        }
    }

    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        x: clamp(parent.width * ratio - 6px, 0px, parent.width - 12px);
        y: (parent.height - self.height) / 2;
        opacity: (ta.has-hover || ta.pressed) ? 1.0 : 0.0;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000066;
        animate opacity { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (self.width > 0px) {
                value = clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(value);
            }
        }
        moved => {
            if (self.pressed && self.width > 0px) {
                value = clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(value);
            }
        }
    }
}

export component SearchSkeletonList inherits VerticalLayout {
    in property <bool> active: false;
    spacing: 6px;

    property <float> t-sec: active && !Theme.reduced-motion ? (animation-tick() / 1s) : 0.0;

    for idx in [0, 1, 2, 3, 4, 5]: Rectangle {
        height: 64px;
        border-radius: 8px;
        property <float> pulse: 0.45 + 0.35 * Math.sin(t-sec * 3.8rad - idx * 0.55rad);
        background: #ffffff08;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 12px;
                    border-radius: 4px;
                    background: #ffffff14;
                    opacity: pulse;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 46px;
                    height: 46px;
                    border-radius: 6px;
                    background: #ffffff18;
                    opacity: pulse;
                }
            }

            VerticalLayout {
                horizontal-stretch: 2;
                alignment: center;
                spacing: 7px;
                Rectangle {
                    width: idx == 1 || idx == 4 ? 190px : 150px;
                    height: 13px;
                    border-radius: 6px;
                    background: #ffffff1a;
                    opacity: pulse;
                }
                Rectangle {
                    width: idx == 2 ? 110px : 90px;
                    height: 10px;
                    border-radius: 5px;
                    background: #ffffff12;
                    opacity: pulse;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Rectangle {
                    width: 78px;
                    height: 11px;
                    border-radius: 5px;
                    background: #ffffff12;
                    opacity: pulse;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 11px;
                    border-radius: 5px;
                    background: #ffffff14;
                    opacity: pulse;
                }
            }
        }
    }
}

export component PlaylistResultRow inherits Rectangle {
    in property <RemotePlaylistData> playlist;
    callback clicked();

    height: 70px;
    border-radius: 10px;
    background: ta.has-hover ? #ffffff10 : #17171a88;
    animate background { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 50px;
                height: 50px;
                border-radius: 8px;
                background: #23203a;
                clip: true;

                if playlist.has_cover: Image {
                    source: playlist.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
                if !playlist.has_cover: Image {
                    source: @image-url("icons/ms_queue_music.svg");
                    width: 22px;
                    height: 22px;
                    colorize: Theme.primary;
                    x: 14px;
                    y: 14px;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: playlist.title;
                color: Theme.text-primary;
                font-size: 14.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: playlist.track_count_text != ""
                    ? ("Playlist • " + playlist.author + " • " + playlist.track_count_text)
                    : ("Playlist • " + playlist.author);
                color: Theme.text-secondary;
                font-size: 12px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/chev_right.svg");
                width: 18px;
                height: 18px;
                colorize: ta.has-hover ? Theme.text-primary : Theme.text-muted;
            }
        }
    }
}

export component ArtistResultRow inherits Rectangle {
    in property <ArtistData> artist;
    callback clicked();

    height: 70px;
    border-radius: 10px;
    background: ta.has-hover ? #ffffff10 : #17171a88;
    animate background { duration: Theme.reduced-motion ? 0ms : 140ms; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 50px;
                height: 50px;
                border-radius: 25px;
                background: #23203a;
                clip: true;

                if artist.has_avatar: Image {
                    source: artist.avatar;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
                if !artist.has_avatar: Image {
                    source: @image-url("icons/avatar_default.svg");
                    width: 100%;
                    height: 100%;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: artist.name;
                color: Theme.text-primary;
                font-size: 14.5px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: artist.subtitle;
                color: Theme.text-secondary;
                font-size: 12px;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/chev_right.svg");
                width: 18px;
                height: 18px;
                colorize: ta.has-hover ? Theme.text-primary : Theme.text-muted;
            }
        }
    }
}
