import { ScrollView } from "std-widgets.slint";
import { Theme, TrackData, RemotePlaylistData, ArtistData } from "theme.slint";
import { IconBtn, PillBtn, ToggleSwitch, HomeCard, TrackRow, SearchSkeletonList, PlaylistResultRow, ArtistResultRow } from "components.slint";

component TableHeader inherits Rectangle {
    in property <bool> show-album: true;
    in property <bool> show-extra-cols: false;
    height: 28px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        Text { width: 24px; text: "#"; color: Theme.text-muted; font-size: 12px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { width: 46px; }
        Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 2; text: "Title"; color: Theme.text-muted; font-size: 12px; font-weight: 500; vertical-alignment: center; }
        if show-album: Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: "Album"; color: Theme.text-muted; font-size: 12px; font-weight: 500; vertical-alignment: center; }
        if show-extra-cols: Text { width: 64px; text: "Plays"; color: Theme.text-muted; font-size: 12px; font-weight: 500; vertical-alignment: center; }
        if show-extra-cols: Text { width: 90px; text: "Date added"; color: Theme.text-muted; font-size: 12px; font-weight: 500; vertical-alignment: center; }
        Rectangle { width: 64px; }
        VerticalLayout {
            width: 44px;
            alignment: center;
            HorizontalLayout {
                alignment: end;
                Image { source: @image-url("icons/clock.svg"); width: 14px; height: 14px; colorize: Theme.text-muted; }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: 100%;
        background: #ffffff14;
    }
}

export component HomeView inherits ScrollView {
    in property <[TrackData]> for-you-tracks: [];
    in property <[TrackData]> trending-tracks: [];
    in property <[TrackData]> jump-back-tracks: [];
    in property <[ArtistData]> top-artists: [];
    in property <int> fav-count: 0;
    in property <int> local-count: 0;
    in property <int> hist-count: 0;
    callback open-tab(int);
    callback play-track(TrackData);
    callback open-artist(ArtistData);
    callback refresh-home();

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 28px;
        spacing: 26px;
        alignment: start;

        // Section: Home > (Quick tiles row: 3-column grid matching .sp-quick)
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/home.svg"); width: 20px; height: 20px; colorize: Theme.text-primary; }
                }
                Text {
                    text: "Home";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    icon: @image-url("icons/chev_right.svg");
                    icon-size: 18px;
                    clicked => { root.open-tab(3); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                height: 64px;

                // Liked songs tile
                Rectangle {
                    horizontal-stretch: 1;
                    height: 64px;
                    border-radius: 12px;
                    background: t1.has-hover ? #2a2a30 : #1c1c20b3;
                    clip: true;
                    animate background { duration: 180ms; easing: ease; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-right: 10px;
                        Image {
                            source: @image-url("assets/liked.png");
                            width: 64px;
                            height: 64px;
                            image-fit: cover;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Liked songs"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; overflow: elide; }
                            if fav-count > 0: Text { text: fav-count + " songs"; color: Theme.text-muted; font-size: 12px; overflow: elide; }
                        }
                    }
                    t1 := TouchArea { mouse-cursor: pointer; clicked => { root.open-tab(3); } }
                }

                // My files tile (spacer when no local tracks)
                if local-count > 0: Rectangle {
                    horizontal-stretch: 1;
                    height: 64px;
                    border-radius: 12px;
                    background: t2.has-hover ? #2a2a30 : #1c1c20b3;
                    clip: true;
                    animate background { duration: 180ms; easing: ease; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-right: 10px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            background: #000000;
                            Image {
                                source: @image-url("icons/cloud_off.svg");
                                width: 26px;
                                height: 26px;
                                colorize: #ffffff;
                                x: 19px;
                                y: 19px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "My files"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; overflow: elide; }
                            Text { text: local-count + " tracks"; color: Theme.text-muted; font-size: 12px; overflow: elide; }
                        }
                    }
                    t2 := TouchArea { mouse-cursor: pointer; clicked => { root.open-tab(2); } }
                }
                if local-count == 0: Rectangle { horizontal-stretch: 1; }

                // History tile (spacer when no history)
                if hist-count > 0: Rectangle {
                    horizontal-stretch: 1;
                    height: 64px;
                    border-radius: 12px;
                    background: t3.has-hover ? #2a2a30 : #1c1c20b3;
                    clip: true;
                    animate background { duration: 180ms; easing: ease; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-right: 10px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            background: #1e1d2b;
                            Image {
                                source: @image-url("icons/ms_history.svg");
                                width: 26px;
                                height: 26px;
                                colorize: Theme.primary;
                                x: 19px;
                                y: 19px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "History"; color: Theme.text-primary; font-size: 14.5px; font-weight: 600; overflow: elide; }
                            Text { text: hist-count + " played"; color: Theme.text-muted; font-size: 12px; overflow: elide; }
                        }
                    }
                    t3 := TouchArea { mouse-cursor: pointer; clicked => { root.open-tab(4); } }
                }
                if hist-count == 0: Rectangle { horizontal-stretch: 1; }
            }
        }

        // Section: For you [refresh] >
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/bars_wave.svg"); width: 20px; height: 20px; colorize: Theme.text-primary; }
                }
                Text {
                    text: "For you";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        width: 32px;
                        height: 32px;
                        base-bg: #17171a;
                        icon: @image-url("icons/refresh.svg");
                        icon-size: 15px;
                        clicked => { root.refresh-home(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    icon: @image-url("icons/chev_right.svg");
                    icon-size: 18px;
                    clicked => { root.open-tab(1); }
                }
            }

            if for-you-tracks.length == 0: Rectangle {
                height: 180px;
                width: 180px;
                border-radius: 14px;
                background: #17171a;
                Text {
                    width: parent.width - 24px;
                    x: 12px;
                    text: "No songs yet for you — search or check your liked songs";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if for-you-tracks.length > 0: ScrollView {
                height: 244px;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for t in for-you-tracks: HomeCard {
                        track: t;
                        clicked => { root.play-track(t); }
                    }
                }
            }
        }

        // Section: Trending now >
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/flame.svg"); width: 20px; height: 20px; colorize: Theme.text-primary; }
                }
                Text {
                    text: "Trending now";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    icon: @image-url("icons/chev_right.svg");
                    icon-size: 18px;
                    clicked => { root.open-tab(1); }
                }
            }

            if trending-tracks.length == 0: Rectangle {
                height: 180px;
                Text {
                    width: parent.width - 24px;
                    x: 12px;
                    text: "No trending songs found right now. Try again later!";
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if trending-tracks.length > 0: ScrollView {
                height: 244px;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for t in trending-tracks: HomeCard {
                        track: t;
                        clicked => { root.play-track(t); }
                    }
                }
            }
        }

        // Section: Jump back in > (recent history shelf)
        if jump-back-tracks.length > 0: VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/ms_history.svg"); width: 20px; height: 20px; colorize: Theme.text-primary; }
                }
                Text {
                    text: "Jump back in";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    icon: @image-url("icons/chev_right.svg");
                    icon-size: 18px;
                    clicked => { root.open-tab(4); }
                }
            }

            ScrollView {
                height: 244px;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for t in jump-back-tracks: HomeCard {
                        track: t;
                        clicked => { root.play-track(t); }
                    }
                }
            }
        }

        // Section: Top Artists (from listening history & favorites)
        if top-artists.length > 0: VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/avatar_default.svg"); width: 20px; height: 20px; }
                }
                Text {
                    text: "Top Artists";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                height: 190px;
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for art in top-artists: Rectangle {
                        width: 146px;
                        height: 180px;
                        border-radius: 12px;
                        background: art-ta.has-hover ? #232329 : transparent;
                        animate background { duration: Theme.reduced-motion ? 0ms : 150ms; easing: ease-out; }

                        art-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-artist(art); }
                        }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 118px;
                                    height: 118px;
                                    border-radius: 59px;
                                    background: #23203a;
                                    clip: true;

                                    if art.has_avatar: Image {
                                        source: art.avatar;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                    }
                                    if !art.has_avatar: Image {
                                        source: @image-url("icons/avatar_default.svg");
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }

                            Text {
                                text: art.name;
                                color: Theme.text-primary;
                                font-size: 13.5px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SearchView inherits ScrollView {
    in property <[TrackData]> tracks: [];
    in property <[RemotePlaylistData]> playlists: [];
    in property <[ArtistData]> artists: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    in property <bool> is-buffering: false;
    in property <bool> is-searching: false;
    in property <bool> has-searched: false;
    in property <string> search-error: "";
    in-out property <string> search-platform: "ytmusic";
    in-out property <string> search-type: "all"; // "all" | "songs" | "playlists" | "artists"
    callback play-track(TrackData);
    callback platform-changed(string);
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback download-track(TrackData);
    callback open-remote-playlist(RemotePlaylistData);
    callback open-artist(ArtistData);
    callback open-artist-name(string);
    callback retry-search();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        // Platform filter chips (search-filter-chips)
        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            alignment: start;

            for chip in [
                { id: "ytmusic", label: "YouTube Music" },
                { id: "youtube", label: "YouTube" },
                { id: "soundcloud", label: "SoundCloud" },
                { id: "local", label: "Local" },
            ]: Rectangle {
                height: 32px;
                border-radius: 16px;
                background: search-platform == chip.id ? Theme.text-primary : (cta.has-hover ? #26262c : #1c1c20);
                animate background { duration: 140ms; easing: ease-out; }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: chip.label;
                        color: search-platform == chip.id ? #0d0d0d : Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        animate color { duration: 140ms; easing: ease-out; }
                    }
                }

                cta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        search-platform = chip.id;
                        root.platform-changed(chip.id);
                    }
                }
            }
        }

        // Result Type chips (All / Songs / Playlists / Artists)
        HorizontalLayout {
            spacing: 6px;
            height: 30px;
            alignment: start;

            for tchip in [
                { id: "all", label: "All" },
                { id: "songs", label: "Songs" },
                { id: "playlists", label: "Playlists" },
                { id: "artists", label: "Artists" },
            ]: Rectangle {
                height: 28px;
                border-radius: 14px;
                background: search-type == tchip.id ? Theme.primary-dim : (st-ta.has-hover ? #ffffff14 : #ffffff0a);
                animate background { duration: 120ms; easing: ease-out; }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: tchip.label;
                        color: search-type == tchip.id ? Theme.primary-dim-text : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: search-type == tchip.id ? 700 : 500;
                        vertical-alignment: center;
                    }
                }

                st-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { search-type = tchip.id; }
                }
            }
        }

        // Animated Shimmer Loading Skeleton while searching
        if is-searching: SearchSkeletonList {
            active: is-searching;
        }

        if !is-searching && search-error != "": VerticalLayout {
            padding-top: 28px;
            spacing: 12px;
            alignment: center;
            Text {
                text: search-error;
                color: #f28b82;
                font-size: 13.5px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                PillBtn {
                    label: "Retry search";
                    primary: true;
                    clicked => { root.retry-search(); }
                }
            }
        }

        if !is-searching && search-error == "" && tracks.length == 0 && playlists.length == 0 && artists.length == 0: VerticalLayout {
            padding-top: 36px;
            spacing: 12px;
            alignment: center;
            Text {
                text: has-searched
                    ? "No results found. Try another keyword or switch platform."
                    : "Type in the search bar above and press Enter to search tracks, playlists, or artists.";
                color: Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if has-searched: HorizontalLayout {
                alignment: center;
                PillBtn {
                    label: "Retry";
                    clicked => { root.retry-search(); }
                }
            }
        }

        // Artists section
        if !is-searching && (search-type == "all" || search-type == "artists") && artists.length > 0: VerticalLayout {
            spacing: 6px;
            Text {
                text: "Artists";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            for a in artists: ArtistResultRow {
                artist: a;
                clicked => { root.open-artist(a); }
            }
        }

        // Playlists section
        if !is-searching && (search-type == "all" || search-type == "playlists") && playlists.length > 0: VerticalLayout {
            spacing: 6px;
            Text {
                text: "Playlists";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            for p in playlists: PlaylistResultRow {
                playlist: p;
                clicked => { root.open-remote-playlist(p); }
            }
        }

        // Songs section
        if !is-searching && (search-type == "all" || search-type == "songs") && tracks.length > 0: VerticalLayout {
            spacing: 4px;
            if search-type == "all" && (artists.length > 0 || playlists.length > 0): Text {
                text: "Songs";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            TableHeader { show-album: root.width >= 460px; }
            for t[idx] in tracks: TrackRow {
                index: idx;
                track: t;
                is-current: t.id == current-id && current-id != "";
                is-playing: root.is-playing;
                is-buffering: root.is-buffering;
                show-album: root.width >= 460px;
                play-clicked => { root.play-track(t); }
                toggle-favorite => { root.toggle-favorite(t); }
                add-to-playlist => { root.add-to-playlist(t); }
                add-to-queue => { root.add-to-queue(t); }
                play-next-clicked => { root.play-next(t); }
                download-clicked => { root.download-track(t); }
                artist-clicked(name) => { root.open-artist-name(name); }
            }
        }
    }
}

export component LocalFilesView inherits ScrollView {
    in property <[TrackData]> tracks: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    in-out property <string> filter-query: "";
    in-out property <bool> filter-open: false;
    callback play-track(TrackData);
    callback shuffle-play();
    callback add-files();
    callback scan-folder();
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback remove-local-track(TrackData);
    callback open-artist-name(string);
    callback filter-changed(string);
    callback cycle-sort();

    property <bool> is-narrow: root.width < 540px;
    property <length> hero-cover: root.width < 520px ? 112px : (root.width < 680px ? 164px : 220px);
    property <length> hero-pad: is-narrow ? 16px : 24px;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // Seamless hero + action bar container (persis web_local.png, zero horizontal seam)
        Rectangle {
            background: @linear-gradient(180deg, #26262c 0%, #18181c 52%, #0d0d0d00 100%);

            VerticalLayout {
                spacing: 0px;

                // Hero header
                HorizontalLayout {
                    padding: hero-pad;
                    spacing: is-narrow ? 16px : 24px;
                    alignment: start;

                    Rectangle {
                        width: hero-cover;
                        height: hero-cover;
                        border-radius: 8px;
                        background: #000000;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #00000066;

                        Image {
                            source: @image-url("icons/cloud_off.svg");
                            width: hero-cover * 0.36;
                            height: hero-cover * 0.36;
                            colorize: #ffffff;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 6px;
                        padding-bottom: is-narrow ? 2px : 8px;

                        Text {
                            text: "My files";
                            color: Theme.text-primary;
                            font-size: root.width < 520px ? 34px : (root.width < 680px ? 52px : 72px);
                            font-weight: 800;
                            overflow: elide;
                        }

                        Text {
                            text: tracks.length + " tracks in library";
                            color: Theme.text-secondary;
                            font-size: is-narrow ? 13px : 14px;
                            overflow: elide;
                        }
                    }
                }

                // Action bar (persis web_local.png)
                HorizontalLayout {
                    padding-left: is-narrow ? 12px : 24px;
                    padding-right: is-narrow ? 12px : 24px;
                    padding-top: 8px;
                    padding-bottom: 14px;
                    spacing: is-narrow ? 4px : 10px;

                    IconBtn {
                        width: is-narrow ? 28px : 36px;
                        height: is-narrow ? 28px : 36px;
                        icon: @image-url("icons/play_fill.svg");
                        icon-size: is-narrow ? 18px : 20px;
                        disabled: tracks.length == 0;
                        clicked => {
                            if (tracks.length > 0) { root.play-track(tracks[0]); }
                        }
                    }

                    IconBtn {
                        width: is-narrow ? 28px : 36px;
                        height: is-narrow ? 28px : 36px;
                        icon: @image-url("icons/shuffle.svg");
                        icon-size: is-narrow ? 16px : 18px;
                        disabled: tracks.length == 0;
                        clicked => { root.shuffle-play(); }
                    }

                    PillBtn {
                        label: "Add files";
                        icon: @image-url("icons/ms_add.svg");
                        has-icon: true;
                        btn-height: 32px;
                        h-pad: is-narrow ? 9px : 12px;
                        radius: 8px;
                        clicked => { root.add-files(); }
                    }

                    PillBtn {
                        label: "Add folder";
                        icon: @image-url("icons/folder_stroke.svg");
                        has-icon: true;
                        btn-height: 32px;
                        h-pad: is-narrow ? 9px : 12px;
                        radius: 8px;
                        clicked => { root.scan-folder(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if filter-open: Rectangle {
                        width: is-narrow ? 130px : 190px;
                        height: 32px;
                        border-radius: 16px;
                        background: #ffffff14;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                if filter-query == "": Text {
                                    text: "Filter files...";
                                    color: Theme.text-muted;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                loc-flt := TextInput {
                                    text <=> filter-query;
                                    color: Theme.text-primary;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => { root.filter-changed(filter-query); }
                                }
                            }
                            if filter-query != "": IconBtn {
                                width: 22px;
                                height: 22px;
                                icon: @image-url("icons/ms_close.svg");
                                icon-size: 12px;
                                clicked => {
                                    filter-query = "";
                                    root.filter-changed("");
                                }
                            }
                        }
                    }

                    IconBtn {
                        width: is-narrow ? 28px : 36px;
                        height: is-narrow ? 28px : 36px;
                        icon: @image-url("icons/search_stroke.svg");
                        icon-size: is-narrow ? 16px : 18px;
                        active: filter-open;
                        active-bg: #ffffff18;
                        active-icon-color: Theme.text-primary;
                        clicked => {
                            filter-open = !filter-open;
                            if (!filter-open && filter-query != "") {
                                filter-query = "";
                                root.filter-changed("");
                            }
                        }
                    }

                    IconBtn {
                        width: is-narrow ? 28px : 36px;
                        height: is-narrow ? 28px : 36px;
                        icon: @image-url("icons/ms_sort.svg");
                        icon-size: is-narrow ? 16px : 18px;
                        clicked => { root.cycle-sort(); }
                    }
                }
            }
        }

        if tracks.length == 0: VerticalLayout {
            padding-top: 36px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;
            alignment: center;

            Text {
                text: "No local tracks in library yet.";
                color: Theme.text-muted;
                font-size: 14.5px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                PillBtn {
                    label: "Add files";
                    icon: @image-url("icons/ms_add.svg");
                    has-icon: true;
                    primary: true;
                    btn-height: 40px;
                    radius: 10px;
                    clicked => { root.add-files(); }
                }
                PillBtn {
                    label: "Add folder";
                    icon: @image-url("icons/folder_stroke.svg");
                    has-icon: true;
                    btn-height: 40px;
                    radius: 10px;
                    clicked => { root.scan-folder(); }
                }
            }
        }

        if tracks.length > 0: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 4px;

            TableHeader { show-album: root.width >= 460px; }

            for t[idx] in tracks: TrackRow {
                index: idx;
                track: t;
                is-current: t.id == current-id && current-id != "";
                is-playing: root.is-playing;
                show-album: root.width >= 460px;
                show-remove: true;
                play-clicked => { root.play-track(t); }
                toggle-favorite => { root.toggle-favorite(t); }
                add-to-playlist => { root.add-to-playlist(t); }
                add-to-queue => { root.add-to-queue(t); }
                play-next-clicked => { root.play-next(t); }
                remove-clicked => { root.remove-local-track(t); }
                artist-clicked(name) => { root.open-artist-name(name); }
            }
        }
    }
}

export component FavoritesView inherits ScrollView {
    in property <[TrackData]> tracks: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    in-out property <string> filter-query: "";
    in-out property <bool> filter-open: false;
    callback play-track(TrackData);
    callback shuffle-play();
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback download-track(TrackData);
    callback open-artist-name(string);
    callback filter-changed(string);
    callback cycle-sort();

    property <bool> is-narrow: root.width < 540px;
    property <length> hero-cover: root.width < 520px ? 112px : (root.width < 680px ? 164px : 220px);
    property <length> hero-pad: is-narrow ? 16px : 24px;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // Seamless hero + action bar container (persis web_fav.png, zero horizontal seam)
        Rectangle {
            background: @linear-gradient(180deg, #525256 0%, #2a2a2d 52%, #0d0d0d00 100%);

            VerticalLayout {
                spacing: 0px;

                // Hero header
                HorizontalLayout {
                    padding: hero-pad;
                    spacing: is-narrow ? 16px : 24px;
                    alignment: start;

                    Rectangle {
                        width: hero-cover;
                        height: hero-cover;
                        border-radius: 8px;
                        background: #1a1a1e;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #00000066;

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 8px;
                            clip: true;

                            Image {
                                source: @image-url("assets/liked.png");
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 6px;
                        padding-bottom: is-narrow ? 2px : 8px;

                        Text {
                            text: "Liked Songs";
                            color: Theme.text-primary;
                            font-size: root.width < 520px ? 32px : (root.width < 680px ? 50px : 72px);
                            font-weight: 800;
                            overflow: elide;
                        }

                        Text {
                            text: "User • " + tracks.length + " songs";
                            color: Theme.text-secondary;
                            font-size: is-narrow ? 13px : 14px;
                            overflow: elide;
                        }
                    }
                }

                // Action bar (persis web_fav.png)
                HorizontalLayout {
                    padding-left: is-narrow ? 14px : 24px;
                    padding-right: is-narrow ? 14px : 24px;
                    padding-top: 8px;
                    padding-bottom: 14px;
                    spacing: 10px;

                    IconBtn {
                        icon: @image-url("icons/play_fill.svg");
                        icon-size: 20px;
                        disabled: tracks.length == 0;
                        clicked => {
                            if (tracks.length > 0) { root.play-track(tracks[0]); }
                        }
                    }

                    IconBtn {
                        icon: @image-url("icons/shuffle.svg");
                        icon-size: 18px;
                        disabled: tracks.length == 0;
                        clicked => { root.shuffle-play(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if filter-open: Rectangle {
                        width: is-narrow ? 140px : 200px;
                        height: 32px;
                        border-radius: 16px;
                        background: #ffffff14;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                if filter-query == "": Text {
                                    text: "Filter liked songs...";
                                    color: Theme.text-muted;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                fav-flt := TextInput {
                                    text <=> filter-query;
                                    color: Theme.text-primary;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => { root.filter-changed(filter-query); }
                                }
                            }
                            if filter-query != "": IconBtn {
                                width: 22px;
                                height: 22px;
                                icon: @image-url("icons/ms_close.svg");
                                icon-size: 12px;
                                clicked => {
                                    filter-query = "";
                                    root.filter-changed("");
                                }
                            }
                        }
                    }

                    IconBtn {
                        icon: @image-url("icons/search_stroke.svg");
                        icon-size: 18px;
                        active: filter-open;
                        active-bg: #ffffff18;
                        active-icon-color: Theme.text-primary;
                        clicked => {
                            filter-open = !filter-open;
                            if (!filter-open && filter-query != "") {
                                filter-query = "";
                                root.filter-changed("");
                            }
                        }
                    }

                    IconBtn {
                        icon: @image-url("icons/ms_sort.svg");
                        icon-size: 18px;
                        clicked => { root.cycle-sort(); }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 4px;

            TableHeader {
                show-album: root.width >= 360px;
                show-extra-cols: root.width >= 540px;
            }

            if tracks.length == 0: Rectangle {
                height: 100px;
                Text {
                    width: parent.width - 24px;
                    x: 12px;
                    text: "No favourites yet. Use the heart on a track to save it";
                    color: Theme.text-muted;
                    font-size: 14.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            for t[idx] in tracks: TrackRow {
                index: idx;
                track: t;
                is-current: t.id == current-id && current-id != "";
                is-playing: root.is-playing;
                show-album: root.width >= 460px;
                play-clicked => { root.play-track(t); }
                toggle-favorite => { root.toggle-favorite(t); }
                add-to-playlist => { root.add-to-playlist(t); }
                add-to-queue => { root.add-to-queue(t); }
                play-next-clicked => { root.play-next(t); }
                download-clicked => { root.download-track(t); }
                artist-clicked(name) => { root.open-artist-name(name); }
            }
        }
    }
}

export component HistoryView inherits ScrollView {
    in property <[TrackData]> tracks: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    callback play-track(TrackData);
    callback clear-history();
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback download-track(TrackData);
    callback open-artist-name(string);

    property <bool> is-narrow: root.width < 540px;
    property <length> hero-cover: root.width < 520px ? 112px : 168px;
    property <length> hero-pad: is-narrow ? 16px : 24px;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        Rectangle {
            background: @linear-gradient(180deg, #282366 0%, #16152b 52%, #0d0d0d00 100%);

            VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding: hero-pad;
                    spacing: is-narrow ? 16px : 22px;
                    alignment: start;

                    Rectangle {
                        width: hero-cover;
                        height: hero-cover;
                        border-radius: 8px;
                        background: #1a1930;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #00000066;

                        Image {
                            source: @image-url("icons/ms_history.svg");
                            width: hero-cover * 0.38;
                            height: hero-cover * 0.38;
                            colorize: Theme.primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 6px;
                        padding-bottom: is-narrow ? 2px : 6px;

                        Text {
                            text: "History";
                            color: Theme.text-primary;
                            font-size: root.width < 520px ? 34px : 56px;
                            font-weight: 800;
                            overflow: elide;
                        }

                        Text {
                            text: tracks.length + " recently played";
                            color: Theme.text-secondary;
                            font-size: is-narrow ? 13px : 14px;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: is-narrow ? 14px : 24px;
                    padding-right: is-narrow ? 14px : 24px;
                    padding-top: 8px;
                    padding-bottom: 14px;
                    spacing: 12px;
                    alignment: start;

                    IconBtn {
                        icon: @image-url("icons/play_fill.svg");
                        icon-size: 20px;
                        disabled: tracks.length == 0;
                        clicked => {
                            if (tracks.length > 0) { root.play-track(tracks[0]); }
                        }
                    }

                    PillBtn {
                        label: "Clear history";
                        clicked => { root.clear-history(); }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 4px;

            TableHeader { show-album: root.width >= 460px; }

            if tracks.length == 0: Rectangle {
                height: 100px;
                Text {
                    width: parent.width - 24px;
                    x: 12px;
                    text: "No playback history yet.";
                    color: Theme.text-muted;
                    font-size: 14.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            for t[idx] in tracks: TrackRow {
                index: idx;
                track: t;
                is-current: t.id == current-id && current-id != "";
                is-playing: root.is-playing;
                show-album: root.width >= 460px;
                play-clicked => { root.play-track(t); }
                toggle-favorite => { root.toggle-favorite(t); }
                add-to-playlist => { root.add-to-playlist(t); }
                add-to-queue => { root.add-to-queue(t); }
                play-next-clicked => { root.play-next(t); }
                download-clicked => { root.download-track(t); }
                artist-clicked(name) => { root.open-artist-name(name); }
            }
        }
    }
}

export component QueueView inherits ScrollView {
    in property <[TrackData]> tracks: [];
    in property <[TrackData]> recommended-tracks: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    in property <bool> is-buffering: false;
    in-out property <bool> autoplay-enabled: true;
    in-out property <string> autoplay-mode: "similar"; // "similar" | "artist" | "discovery"
    in property <bool> autoplay-loading: false;
    callback play-track(TrackData);
    callback clear-queue();
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback download-track(TrackData);
    callback move-queue-item(int, int);
    callback remove-queue-at(int);
    callback toggle-autoplay(bool);
    callback change-autoplay-mode(string);
    callback refresh-recommendations();
    callback open-artist-name(string);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout {
            height: 40px;
            spacing: 12px;

            Text {
                text: "Playback queue";
                color: Theme.text-primary;
                font-size: 24px;
                font-weight: 800;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            PillBtn {
                label: "Clear queue";
                clicked => { root.clear-queue(); }
            }
        }

        // Autoplay & Recommendations control card
        Rectangle {
            border-radius: 12px;
            background: #17171c;
            border-width: 1px;
            border-color: #ffffff10;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "Autoplay";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: autoplay-enabled
                                ? "Automatically queue & play recommended songs after the current track"
                                : "Playback stops when the queue finishes";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        ToggleSwitch {
                            checked <=> autoplay-enabled;
                            toggled(on) => { root.toggle-autoplay(on); }
                        }
                    }
                }

                if autoplay-enabled: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for m in [
                        { id: "similar", label: "Similar Vibe" },
                        { id: "artist", label: "Artist Mix" },
                        { id: "discovery", label: "Discovery" },
                    ]: PillBtn {
                        label: m.label;
                        btn-height: 28px;
                        h-pad: 11px;
                        primary: autoplay-mode == m.id;
                        clicked => {
                            autoplay-mode = m.id;
                            root.change-autoplay-mode(m.id);
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    IconBtn {
                        width: 28px;
                        height: 28px;
                        base-bg: #ffffff12;
                        icon: @image-url("icons/refresh.svg");
                        icon-size: 14px;
                        clicked => { root.refresh-recommendations(); }
                    }
                }
            }
        }

        if tracks.length > 0: TableHeader { show-album: root.width >= 460px; }

        if tracks.length == 0: Rectangle {
            height: 110px;
            Text {
                width: parent.width - 24px;
                x: 12px;
                text: "Queue is empty. Play a track or playlist to populate the queue.";
                color: Theme.text-muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            spacing: 2px;
            for t[idx] in tracks: TrackRow {
                index: idx;
                track: t;
                is-current: t.id == current-id && current-id != "";
                is-playing: root.is-playing;
                is-buffering: root.is-buffering;
                show-album: root.width >= 460px;
                show-queue-btn: false;
                show-play-next: false;
                show-reorder: true;
                show-remove: true;
                play-clicked => { root.play-track(t); }
                toggle-favorite => { root.toggle-favorite(t); }
                add-to-playlist => { root.add-to-playlist(t); }
                download-clicked => { root.download-track(t); }
                move-up-clicked => { root.move-queue-item(idx, idx - 1); }
                move-down-clicked => { root.move-queue-item(idx, idx + 1); }
                remove-clicked => { root.remove-queue-at(idx); }
                artist-clicked(name) => { root.open-artist-name(name); }
            }
        }

        // Up Next • Recommended section
        if autoplay-enabled: VerticalLayout {
            padding-top: 8px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Recommended next";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if autoplay-loading: Text {
                    text: "Loading...";
                    color: Theme.primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            if autoplay-loading && recommended-tracks.length == 0: SearchSkeletonList {
                active: autoplay-loading;
            }

            if !autoplay-loading && recommended-tracks.length == 0: Text {
                text: "Play a song to generate Up Next recommendations.";
                color: Theme.text-muted;
                font-size: 13px;
            }

            for rt[ridx] in recommended-tracks: TrackRow {
                index: ridx;
                track: rt;
                is-current: rt.id == current-id && current-id != "";
                is-playing: root.is-playing;
                show-album: root.width >= 460px;
                play-clicked => { root.play-track(rt); }
                toggle-favorite => { root.toggle-favorite(rt); }
                add-to-playlist => { root.add-to-playlist(rt); }
                add-to-queue => { root.add-to-queue(rt); }
                play-next-clicked => { root.play-next(rt); }
                download-clicked => { root.download-track(rt); }
                artist-clicked(name) => { root.open-artist-name(name); }
            }
        }
    }
}

export component PlaylistDetailView inherits ScrollView {
    in property <string> playlist-id: "";
    in property <string> playlist-name: "Playlist";
    in property <bool> is-remote: false;
    in property <bool> is-loading: false;
    in property <bool> is-downloading-all: false;
    in property <float> download-all-progress: 0.0;
    in property <[TrackData]> tracks: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    callback play-track(TrackData);
    callback play-all();
    callback shuffle-play();
    callback delete-playlist(string);
    callback rename-playlist(string, string);
    callback save-remote-playlist();
    callback download-all-playlist();
    callback remove-track-from-playlist(string, string);
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback download-track(TrackData);
    callback open-artist-name(string);
    callback go-back();

    property <bool> rename-open: false;
    property <string> rename-draft: "";

    property <bool> is-narrow: root.width < 540px;
    property <length> hero-cover: root.width < 520px ? 112px : (root.width < 680px ? 164px : 220px);
    property <length> hero-pad: is-narrow ? 16px : 24px;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // Hero header (persis web_fav.png style)
        Rectangle {
            background: @linear-gradient(180deg, #3b336b 0%, #1d1a33 52%, #0d0d0d00 100%);

            VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding: hero-pad;
                    spacing: is-narrow ? 16px : 24px;
                    alignment: start;

                    Rectangle {
                        width: hero-cover;
                        height: hero-cover;
                        border-radius: 8px;
                        background: #23203a;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #00000066;
                        clip: true;

                        if tracks.length > 0 && tracks[0].has_cover: Image {
                            source: tracks[0].cover;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if tracks.length == 0 || !tracks[0].has_cover: Image {
                            source: @image-url("icons/ms_queue_music.svg");
                            width: hero-cover * 0.38;
                            height: hero-cover * 0.38;
                            colorize: Theme.primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 6px;
                        padding-bottom: is-narrow ? 2px : 8px;

                        Text {
                            text: is-remote ? "Remote Playlist" : "Playlist";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Text {
                            text: playlist-name;
                            color: Theme.text-primary;
                            font-size: root.width < 520px ? 30px : (root.width < 680px ? 46px : 64px);
                            font-weight: 800;
                            overflow: elide;
                        }

                        Text {
                            text: tracks.length + " tracks";
                            color: Theme.text-secondary;
                            font-size: is-narrow ? 13px : 14px;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: is-narrow ? 14px : 24px;
                    padding-right: is-narrow ? 14px : 24px;
                    padding-top: 8px;
                    padding-bottom: 14px;
                    spacing: 10px;

                    IconBtn {
                        icon: @image-url("icons/chev_left.svg");
                        icon-size: 18px;
                        clicked => { root.go-back(); }
                    }

                    IconBtn {
                        icon: @image-url("icons/play_fill.svg");
                        icon-size: 20px;
                        disabled: tracks.length == 0;
                        clicked => { root.play-all(); }
                    }

                    IconBtn {
                        icon: @image-url("icons/shuffle.svg");
                        icon-size: 18px;
                        disabled: tracks.length == 0;
                        clicked => { root.shuffle-play(); }
                    }

                    if is-remote && tracks.length > 0: PillBtn {
                        label: "Save to Library";
                        icon: @image-url("icons/ms_add.svg");
                        has-icon: true;
                        primary: true;
                        clicked => { root.save-remote-playlist(); }
                    }

                    if tracks.length > 0: PillBtn {
                        label: is-downloading-all ? ("Downloading " + Math.round(download-all-progress * 100) + "%") : "Download All";
                        icon: @image-url("icons/download.svg");
                        has-icon: true;
                        disabled: is-downloading-all;
                        clicked => { root.download-all-playlist(); }
                    }

                    if !is-remote: IconBtn {
                        icon: @image-url("icons/ms_edit.svg");
                        icon-size: 17px;
                        clicked => {
                            rename-draft = playlist-name;
                            rename-open = !rename-open;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if !is-remote: IconBtn {
                        icon: @image-url("icons/trash.svg");
                        icon-size: 18px;
                        icon-color: #f28b82;
                        clicked => { root.delete-playlist(playlist-id); }
                    }
                }

                if !is-remote && rename-open: HorizontalLayout {
                    padding-left: is-narrow ? 14px : 24px;
                    padding-right: is-narrow ? 14px : 24px;
                    padding-bottom: 14px;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 10px;
                        background: #141418;
                        border-width: 1px;
                        border-color: Theme.primary;
                        TextInput {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            height: 20px;
                            text <=> rename-draft;
                            color: Theme.text-primary;
                            font-size: 13.5px;
                            single-line: true;
                            accepted => {
                                if (rename-draft != "") {
                                    root.rename-playlist(playlist-id, rename-draft);
                                    rename-open = false;
                                }
                            }
                        }
                    }

                    PillBtn {
                        label: "Save";
                        primary: true;
                        clicked => {
                            if (rename-draft != "") {
                                root.rename-playlist(playlist-id, rename-draft);
                                rename-open = false;
                            }
                        }
                    }

                    PillBtn {
                        label: "Cancel";
                        clicked => { rename-open = false; }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 4px;

            if is-loading: SearchSkeletonList { active: is-loading; }

            if !is-loading: TableHeader { show-album: root.width >= 460px; }

            if !is-loading && tracks.length == 0: Rectangle {
                height: 100px;
                Text {
                    width: parent.width - 24px;
                    x: 12px;
                    text: "This playlist is empty. Hover any track and click + to add songs.";
                    color: Theme.text-muted;
                    font-size: 14.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if !is-loading: VerticalLayout {
                spacing: 2px;
                for t[idx] in tracks: TrackRow {
                    index: idx;
                    track: t;
                    is-current: t.id == current-id && current-id != "";
                    is-playing: root.is-playing;
                    show-album: root.width >= 460px;
                    show-remove: !is-remote;
                    play-clicked => { root.play-track(t); }
                    toggle-favorite => { root.toggle-favorite(t); }
                    add-to-playlist => { root.add-to-playlist(t); }
                    add-to-queue => { root.add-to-queue(t); }
                    play-next-clicked => { root.play-next(t); }
                    download-clicked => { root.download-track(t); }
                    remove-clicked => { root.remove-track-from-playlist(playlist-id, t.id); }
                    artist-clicked(name) => { root.open-artist-name(name); }
                }
            }
        }
    }
}

export component ArtistView inherits ScrollView {
    in property <string> artist-name: "Artist";
    in property <string> artist-subtitle: "Artist";
    in property <image> artist-avatar;
    in property <bool> has-avatar: false;
    in property <bool> is-loading: false;
    in property <[TrackData]> tracks: [];
    in property <string> current-id: "";
    in property <bool> is-playing: false;
    callback play-track(TrackData);
    callback play-all();
    callback shuffle-play();
    callback toggle-favorite(TrackData);
    callback add-to-playlist(TrackData);
    callback add-to-queue(TrackData);
    callback play-next(TrackData);
    callback download-track(TrackData);
    callback go-back();

    property <bool> is-narrow: root.width < 540px;
    property <length> hero-cover: root.width < 520px ? 104px : (root.width < 680px ? 148px : 184px);
    property <length> hero-pad: is-narrow ? 16px : 24px;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        Rectangle {
            background: @linear-gradient(180deg, #322b57 0%, #191826 54%, #0d0d0d00 100%);

            VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    padding: hero-pad;
                    spacing: is-narrow ? 16px : 24px;
                    alignment: start;

                    Rectangle {
                        width: hero-cover;
                        height: hero-cover;
                        border-radius: hero-cover / 2;
                        background: #23203a;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #00000066;
                        clip: true;

                        if has-avatar: Image {
                            source: artist-avatar;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                        if !has-avatar: Image {
                            source: @image-url("icons/avatar_default.svg");
                            width: 100%;
                            height: 100%;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 6px;
                        padding-bottom: is-narrow ? 2px : 8px;

                        Text {
                            text: "Artist";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Text {
                            text: artist-name;
                            color: Theme.text-primary;
                            font-size: root.width < 520px ? 30px : (root.width < 680px ? 44px : 58px);
                            font-weight: 800;
                            overflow: elide;
                        }

                        Text {
                            text: artist-subtitle + " • " + tracks.length + " songs";
                            color: Theme.text-secondary;
                            font-size: is-narrow ? 13px : 14px;
                            overflow: elide;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: is-narrow ? 14px : 24px;
                    padding-right: is-narrow ? 14px : 24px;
                    padding-top: 8px;
                    padding-bottom: 14px;
                    spacing: 10px;

                    IconBtn {
                        icon: @image-url("icons/chev_left.svg");
                        icon-size: 18px;
                        clicked => { root.go-back(); }
                    }

                    IconBtn {
                        icon: @image-url("icons/play_fill.svg");
                        icon-size: 20px;
                        disabled: tracks.length == 0;
                        clicked => { root.play-all(); }
                    }

                    IconBtn {
                        icon: @image-url("icons/shuffle.svg");
                        icon-size: 18px;
                        disabled: tracks.length == 0;
                        clicked => { root.shuffle-play(); }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 4px;

            if is-loading: SearchSkeletonList { active: is-loading; }

            if !is-loading && tracks.length > 0: TableHeader { show-album: root.width >= 460px; }

            if !is-loading && tracks.length == 0: Rectangle {
                height: 120px;
                Text {
                    text: "No songs found for this artist.";
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if !is-loading: VerticalLayout {
                spacing: 2px;
                for t[idx] in tracks: TrackRow {
                    index: idx;
                    track: t;
                    is-current: t.id == current-id && current-id != "";
                    is-playing: root.is-playing;
                    show-album: root.width >= 460px;
                    play-clicked => { root.play-track(t); }
                    toggle-favorite => { root.toggle-favorite(t); }
                    add-to-playlist => { root.add-to-playlist(t); }
                    add-to-queue => { root.add-to-queue(t); }
                    play-next-clicked => { root.play-next(t); }
                    download-clicked => { root.download-track(t); }
                }
            }
        }
    }
}
